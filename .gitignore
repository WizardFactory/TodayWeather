# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

.idea

.DS_Store

# Skill working state and temporary diff snapshots
/.planning/
/reports/sdlc/
/reports/sdlc/**/.state.lock
/reports/sdlc/**/changes.patch

# Archify visual-check outputs are local-only, regardless of directory or format.
# Keep the main diagram HTML and editable JSON; exclude browser-check receipts too.
*.visual-check*
*-visual-check.*
visual-check.*
# Existing renamed copies of Archify's raw browser-check receipts.
/reports/architecture/aws-infrastructure/browser.json
/reports/sdlc/push-diagram/diagram-browser.json
/reports/sdlc/issue-2554/diagram-browser.json
/reports/sdlc/service-architecture/**/*-browser-command.json
# Diagram evidence copies are local artifacts too; app screen captures stay tracked.
/reports/rewrite-verification/server-*-1440x900-*.png
/reports/rewrite-verification/server-*-2048x1320-*.png

# Local EC2 SSH private key
/.aws/aleckim.pem
/.aws/credentials
