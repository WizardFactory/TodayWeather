# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# Local environment files may contain credentials. Keep sanitized examples.
.env
.env.*
!.env.example

.idea

.DS_Store

# Local skill working state and execution reports
/.planning/
/reports/
/.archify/
__pycache__/

# Archify visual-check outputs are local-only, regardless of directory or format.
# Keep the main diagram HTML and editable JSON; exclude browser-check receipts too.
*.visual-check*
*-visual-check.*
visual-check.*
# Local EC2 SSH private key
/.aws/aleckim.pem
/.aws/credentials

# Mobile release inputs. client/.env holds IDs and file locations; see client/.env.example.
/client/.env
/client/.signing/
/client/google-services.json
/client/GoogleService-Info.plist
*.keystore
*.jks
# Generated by the client build (npm scripts in client/package.json).
/client/www/client.config.js
/client/www/lib/
/client/www/css/
/client/platforms/
/client/plugins/

# Web workspaces and local browser verification
/web/dist/
/test-results/
/playwright-report/

# Local Fastlane/Bundler runtime and generated reports.
/client/.bundle/
/client/vendor/bundle/
/client/fastlane/report.xml
/client/fastlane/README.md
/client/fastlane/Preview.html

# Reproducible shared token outputs
/packages/design-tokens/generated/

# PWA token copies are generated from the canonical package.
/web/src/generated/

# Local Archify verification/provenance for the MFDS design; keep JSON source and HTML.
docs/architecture/diagrams/food-poisoning.*.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local Archify 3.0 delivery provenance; keep for browser/recovery gates.
/docs/architecture/diagrams/mobile-weather-request.delivery.json
