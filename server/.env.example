# Copy to .env and configure for the intended environment.
# service does not automatically start gather/scrape/push workers.
SERVER_MODE=service
OPENSHIFT_NODEJS_IP=127.0.0.1
PORT=3000
DB_DATA_VERSION=2.0
MONGOLAB_MONGODB_URL=mongodb://127.0.0.1/todayweather
MONGOLAB_MONGODB_DATABASE=todayweather

# Legacy settings, unused by current production (operator-confirmed 2026-09-24).
# DATA_GO_KR_NORMAL_KEY=
# DATA_GO_KR_CERT_KEY=

# Fill with credentials for the provider features you use; never commit .env.
DATA_GO_KR_TEST_NORMAL_KEY=
DATA_GO_KR_TEST_CERT_KEY=
DONGNAE_SECRET_KEYS='[]'
AIRKOREA_SECRET_KEYS='[]'
DAUM_SECRET_KEYS='[]'
KAKAO_SECRET_KEYS='[]'
# Overseas weather (Visual Crossing Timeline API, #2585).
VC_SECRET_KEY=
