# Copy to .env and configure for the intended environment.
# service does not automatically start gather/scrape/push workers.
SERVER_MODE=service
OPENSHIFT_NODEJS_IP=127.0.0.1
PORT=3000
DB_DATA_VERSION=2.0
MONGOLAB_MONGODB_URL=mongodb://127.0.0.1/todayweather
MONGOLAB_MONGODB_DATABASE=todayweather

# One list for forecast/mid, warnings, UV/pollen, KASI and forecast-zone.
# Approve each required service for at least one key; see CONFIGURATION.md.
# Never commit credentials. Raw or once-percent-encoded keys are supported.
DONGNAE_SECRET_KEYS='[]'
AIRKOREA_SECRET_KEYS='[]'
DAUM_SECRET_KEYS='[]'
KAKAO_SECRET_KEYS='[]'
# Overseas weather (Visual Crossing Timeline API, #2585).
VC_SECRET_KEY=
# Optional daily record budget (UTC day); 0 or unset = no budget. Free plan: 1000.
VC_DAILY_RECORD_LIMIT=
# Push registrations (#2626). Unset = MongoDB. sqlite = one file on this host shared by the
# service workers and server/bin/push-worker; use an absolute path outside the checkout.
# PUSH_STORE=sqlite
# PUSH_DB_PATH=/var/lib/todayweather/push.sqlite

# S3 push coordinator (#2626). Opt-in; default PUSH_STORE remains MongoDB.
# Set PUSH_STORE=s3 only with one separate bin/push-coordinator on this host.
PUSH_SOCKET_PATH=
PUSH_S3_BUCKET=
PUSH_S3_PREFIX=push/v2
PUSH_SEND_CONCURRENCY=128
PUSH_SEND_RATE=500
WARNING_PUSH_ENABLED=false
# Only the existing gather warning collector writes the warning feed.
PUSH_WARNING_FEED_ENABLED=false
