<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Cordova app's App Group: its suite holds the native copy of the Cordova state (a migration source). -->
	<!-- APNs for Firebase Cloud Messaging (IN-04). Distribution uses the production APNs environment. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links for link.todayweather.ai only (#3097, specs/deeplink.md §3.1); never todayweather.ai or app.todayweather.ai. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:link.todayweather.ai</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.wizardfactory.todayweather</string>
	</array>
</dict>
</plist>
