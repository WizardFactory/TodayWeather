// Build settings of the app target. Private values (never in Git) come from the ignored ios/Private.xcconfig; see
// README.md, "Private inputs". Without it the values stay empty and the app sends nothing to the legacy server.
//
// TW_SERVER_URL: the legacy server (Cordova clientConfig.serverUrl), written into Info.plist as TWServerURL. In an
// xcconfig `//` starts a comment, so write the URL as https:/$()/host.
TW_SERVER_URL =

// TW_WEATHER_PHOTOS_URL: the weather photo feed of the photo theme (IN-07), written into Info.plist as
// TWWeatherPhotosURL. Empty without it: the photo theme shows no photo.
TW_WEATHER_PHOTOS_URL =

// TW_MAIL_TO: the feedback address of 의견보내기 (IN-12), written into Info.plist as TWMailTo. Empty without it: the
// mail opens without a recipient.
TW_MAIL_TO =

// TW_PLACES_API_KEY_IOS: the Places SDK key of S01's search (IN-10), restricted to this bundle ID, written into
// Info.plist as TWPlacesAPIKey. Empty without it: S01 searches the bundled towns instead.
TW_PLACES_API_KEY_IOS =

// The placeholder lets an unconfigured build launch the SDK-linked app without sending requests.
// Private.xcconfig supplies the registered iOS app and its native, interstitial and anchored banner (#3211) units for
// Release. Without the banner unit only the banner is off.
TW_ADMOB_APP_ID_IOS = ca-app-pub-0000000000000000~0000000000
TW_ADMOB_NATIVE_IOS =
TW_ADMOB_INTERSTITIAL_IOS =
TW_ADMOB_BANNER_IOS =

// Release signing is scoped to the app target so Swift package resource bundles get no provisioning profile.
CODE_SIGN_STYLE = Automatic

#include? "../Private.xcconfig"

// Use Google's iOS demo units in Debug, including when a private Release configuration is present.
TW_ADMOB_APP_ID_IOS[config=Debug] = ca-app-pub-3940256099942544~1458002511
TW_ADMOB_NATIVE_IOS[config=Debug] = ca-app-pub-3940256099942544/3986624511
TW_ADMOB_INTERSTITIAL_IOS[config=Debug] = ca-app-pub-3940256099942544/4411468910
TW_ADMOB_BANNER_IOS[config=Debug] = ca-app-pub-3940256099942544/2435281174
