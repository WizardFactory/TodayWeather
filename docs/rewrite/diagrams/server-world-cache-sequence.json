{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "World weather request and cache fill",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      669
    ],
    "legend": {
      "entries": {
        "emphasis": {
          "label": "branch start"
        },
        "default": {
          "label": "cache / provider call"
        },
        "return": {
          "label": "return"
        },
        "dashed": {
          "label": "error path"
        }
      }
    }
  },
  "participants": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Client",
      "sublabel": "v000903 DSF route"
    },
    {
      "id": "assembly",
      "type": "backend",
      "label": "Controller",
      "sublabel": "DSF + AQI in parallel"
    },
    {
      "id": "dsf",
      "type": "backend",
      "label": "DSF cache",
      "sublabel": "15-minute current"
    },
    {
      "id": "aqi",
      "type": "backend",
      "label": "AQI cache",
      "sublabel": "60-minute freshness"
    },
    {
      "id": "store",
      "type": "database",
      "label": "MongoDB",
      "sublabel": "weather, air, tz cache"
    },
    {
      "id": "provider",
      "type": "external",
      "label": "Providers",
      "sublabel": "DSF / timezone / WAQI"
    }
  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "assembly",
      "y": 160,
      "label": "coordinates + units"
    },
    {
      "id": "start-dsf",
      "from": "assembly",
      "to": "dsf",
      "y": 188,
      "label": "start weather branch",
      "variant": "emphasis"
    },
    {
      "id": "start-aqi",
      "from": "assembly",
      "to": "aqi",
      "y": 216,
      "label": "start air branch (parallel)",
      "variant": "emphasis"
    },
    {
      "id": "read-dsf",
      "from": "dsf",
      "to": "store",
      "y": 244,
      "label": "read records: yesterday, today, current \u226415 min"
    },
    {
      "id": "read-aqi",
      "from": "aqi",
      "to": "store",
      "y": 272,
      "label": "prune + read air records"
    },
    {
      "id": "fill-current",
      "from": "dsf",
      "to": "provider",
      "y": 300,
      "label": "no current \u226415 min \u2192 fetch current"
    },
    {
      "id": "tz-cache",
      "from": "dsf",
      "to": "store",
      "y": 328,
      "label": "zone id known \u2192 tz cache read, every request"
    },
    {
      "id": "tz-google",
      "from": "dsf",
      "to": "provider",
      "y": 356,
      "label": "tz cache miss \u2192 Google geocode + timezone"
    },
    {
      "id": "fill-history",
      "from": "dsf",
      "to": "provider",
      "y": 384,
      "label": "yesterday missing/incomplete \u2192 \u22643 history fetches"
    },
    {
      "id": "fill-today",
      "from": "dsf",
      "to": "provider",
      "y": 412,
      "label": "today missing \u2192 fetch today"
    },
    {
      "id": "write-dsf",
      "from": "dsf",
      "to": "store",
      "y": 440,
      "label": "upsert per step: renewed current \u00b7 yesterday once gap-free \u00b7 today"
    },
    {
      "id": "return-dsf",
      "from": "dsf",
      "to": "assembly",
      "y": 468,
      "label": "weather records",
      "variant": "return"
    },
    {
      "id": "fill-aqi",
      "from": "aqi",
      "to": "provider",
      "y": 468,
      "label": "if missing/stale: known feed \u2192 geographic fallback"
    },
    {
      "id": "error-dsf",
      "from": "dsf",
      "to": "assembly",
      "y": 496,
      "label": "Error \u2192 next(err) \u2192 HTML 500; string err \u2192 TypeError throw",
      "variant": "dashed",
      "note": "strings '1.'\u2013'3.' fail at err.message += in getDsfData (source anomaly, not reproduced)"
    },
    {
      "id": "write-aqi",
      "from": "aqi",
      "to": "store",
      "y": 496,
      "label": "persist fetched air"
    },
    {
      "id": "return-aqi",
      "from": "aqi",
      "to": "assembly",
      "y": 534,
      "label": "air or tolerated absence",
      "variant": "return"
    },
    {
      "id": "response",
      "from": "assembly",
      "to": "client",
      "y": 562,
      "label": "local time \u2192 merge \u2192 units \u2192 summary \u2192 JSON",
      "variant": "return"
    }
  ]
}
