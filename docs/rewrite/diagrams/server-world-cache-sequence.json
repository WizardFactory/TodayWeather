{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "World weather request and cache fill (Visual Crossing)",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      669
    ],
    "legend": {
      "entries": {
        "emphasis": {
          "label": "branch start"
        },
        "default": {
          "label": "cache / provider call"
        },
        "return": {
          "label": "return"
        },
        "dashed": {
          "label": "error path"
        }
      }
    }
  },
  "participants": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Client",
      "sublabel": "/{v}/dsf/coord \u00b7 /ww"
    },
    {
      "id": "assembly",
      "type": "backend",
      "label": "Controller",
      "sublabel": "weather + AQI in parallel"
    },
    {
      "id": "dsf",
      "type": "backend",
      "label": "World cache",
      "sublabel": "15-minute current"
    },
    {
      "id": "aqi",
      "type": "backend",
      "label": "AQI cache",
      "sublabel": "60-minute freshness"
    },
    {
      "id": "store",
      "type": "database",
      "label": "MongoDB",
      "sublabel": "weather, air, lock, usage"
    },
    {
      "id": "provider",
      "type": "external",
      "label": "Providers",
      "sublabel": "Visual Crossing / WAQI"
    }
  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "assembly",
      "y": 160,
      "label": "coordinates + units"
    },
    {
      "id": "start-dsf",
      "from": "assembly",
      "to": "dsf",
      "y": 188,
      "label": "start weather branch",
      "variant": "emphasis"
    },
    {
      "id": "start-aqi",
      "from": "assembly",
      "to": "aqi",
      "y": 216,
      "label": "start air branch (parallel)",
      "variant": "emphasis"
    },
    {
      "id": "read-dsf",
      "from": "dsf",
      "to": "store",
      "y": 244,
      "label": "read \u22643 d: yesterday \u00b7 today \u00b7 current \u226415 min \u00b7 stale \u22643 h"
    },
    {
      "id": "read-aqi",
      "from": "aqi",
      "to": "store",
      "y": 272,
      "label": "prune + read air records"
    },
    {
      "id": "check",
      "from": "dsf",
      "to": "store",
      "y": 300,
      "label": "provider marker / daily budget \u2192 skip call, serve stored",
      "note": "marker set for 10 min after a daily-limit 429 or 401/403"
    },
    {
      "id": "lock",
      "from": "dsf",
      "to": "store",
      "y": 328,
      "label": "record missing \u2192 take location lock (TTL 10 s)",
      "note": "held elsewhere \u2192 re-read every 250 ms \u22642.5 s; stop at once if the holder flags failed"
    },
    {
      "id": "fill",
      "from": "dsf",
      "to": "provider",
      "y": 356,
      "label": "no observed yesterday \u2192 combined (25) \u00b7 else forecast (1), \u22648 s"
    },
    {
      "id": "write-dsf",
      "from": "dsf",
      "to": "store",
      "y": 384,
      "label": "upsert yesterday \u00b7 today \u00b7 current, release lock, count usage"
    },
    {
      "id": "return-dsf",
      "from": "dsf",
      "to": "assembly",
      "y": 412,
      "label": "records within 2.5 s (late fetch still stored)",
      "variant": "return"
    },
    {
      "id": "fill-aqi",
      "from": "aqi",
      "to": "provider",
      "y": 440,
      "label": "if missing/stale: known feed \u2192 geographic fallback"
    },
    {
      "id": "error-dsf",
      "from": "dsf",
      "to": "assembly",
      "y": 468,
      "label": "no current, no stale \u2192 next(err) \u2192 500",
      "variant": "dashed",
      "note": "fetch failure: lock flagged failed, 2 s backoff; stored current \u22643 h is served instead when present"
    },
    {
      "id": "write-aqi",
      "from": "aqi",
      "to": "store",
      "y": 506,
      "label": "persist fetched air"
    },
    {
      "id": "return-aqi",
      "from": "aqi",
      "to": "assembly",
      "y": 534,
      "label": "air or tolerated absence",
      "variant": "return"
    },
    {
      "id": "response",
      "from": "assembly",
      "to": "client",
      "y": 562,
      "label": "local time \u2192 merge \u2192 units \u2192 JSON, source VC",
      "variant": "return"
    }
  ]
}
