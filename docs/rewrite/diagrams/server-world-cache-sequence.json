{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "World weather request and cache fill",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1050,
      555
    ]
  },
  "participants": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Client",
      "sublabel": "v000903 DSF route"
    },
    {
      "id": "assembly",
      "type": "backend",
      "label": "World controller",
      "sublabel": "DSF + AQI in parallel"
    },
    {
      "id": "dsf",
      "type": "backend",
      "label": "DSF cache",
      "sublabel": "15-minute current"
    },
    {
      "id": "aqi",
      "type": "backend",
      "label": "AQI cache",
      "sublabel": "60-minute freshness"
    },
    {
      "id": "store",
      "type": "database",
      "label": "MongoDB",
      "sublabel": "weather + air records"
    },
    {
      "id": "provider",
      "type": "external",
      "label": "Providers",
      "sublabel": "DSF / timezone / WAQI"
    }
  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "assembly",
      "y": 160,
      "label": "coordinates + units"
    },
    {
      "id": "start-dsf",
      "from": "assembly",
      "to": "dsf",
      "y": 188,
      "label": "start weather branch",
      "variant": "emphasis"
    },
    {
      "id": "start-aqi",
      "from": "assembly",
      "to": "aqi",
      "y": 216,
      "label": "start air branch (parallel)",
      "variant": "emphasis"
    },
    {
      "id": "read-dsf",
      "from": "dsf",
      "to": "store",
      "y": 244,
      "label": "read current + local-day history"
    },
    {
      "id": "read-aqi",
      "from": "aqi",
      "to": "store",
      "y": 272,
      "label": "prune + read air records"
    },
    {
      "id": "fill-dsf",
      "from": "dsf",
      "to": "provider",
      "y": 300,
      "label": "if stale/incomplete: current \u2192 timezone \u2192 history"
    },
    {
      "id": "fill-aqi",
      "from": "aqi",
      "to": "provider",
      "y": 328,
      "label": "if stale: known feed \u2192 geographic fallback"
    },
    {
      "id": "write-dsf",
      "from": "dsf",
      "to": "store",
      "y": 356,
      "label": "upsert fetched weather"
    },
    {
      "id": "write-aqi",
      "from": "aqi",
      "to": "store",
      "y": 384,
      "label": "persist fetched air"
    },
    {
      "id": "return-dsf",
      "from": "dsf",
      "to": "assembly",
      "y": 412,
      "label": "weather records",
      "variant": "return"
    },
    {
      "id": "return-aqi",
      "from": "aqi",
      "to": "assembly",
      "y": 440,
      "label": "air or tolerated absence",
      "variant": "return"
    },
    {
      "id": "response",
      "from": "assembly",
      "to": "client",
      "y": 468,
      "label": "local time \u2192 merge \u2192 units \u2192 summary \u2192 JSON",
      "variant": "return"
    }
  ]
}
