      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "location-to-reject",
      "from": "location",
      "to": "reject",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "preload-to-redirect",
      "from": "preload",
      "to": "redirect",
      "role": "error",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "preload-to-short",
      "from": "preload",
      "to": "short",
      "role": "main"
    },
    {
      "id": "short-to-current",
      "from": "short",
      "to": "current",
      "role": "main"
    },
    {
      "id": "current-to-timeline",
      "from": "current",
      "to": "timeline",
