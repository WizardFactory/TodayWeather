{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Domestic weather response assembly",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "frontend": {
          "label": "Request / response"
        },
        "backend": {
          "label": "Assembly stage"
        },
        "database": {
          "label": "Stored products"
        },
        "external": {
          "label": "External HTTP call"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "read",
      "label": "Ordered pipeline \u00b7 row 1"
    },
    {
      "id": "compose",
      "label": "Row 2"
    },
    {
      "id": "exits",
      "label": "Exits",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "request",
    "location",
    "preload",
    "short",
    "current",
    "timeline",
    "daily",
    "enrich",
    "presentation",
    "response"
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "read",
      "col": 0,
      "type": "frontend",
      "label": "1. KMA request",
      "sublabel": "/kma/addr/\u2026 or /kma/coord/:loc",
      "tag": "address or lat,lon in the path",
      "width": 168
    },
    {
      "id": "coord2addr",
      "lane": "compose",
      "col": 0,
      "type": "external",
      "label": "coord2addr (/coord)",
      "sublabel": "API_SERVER /geocode/coord \u00d73",
      "tag": "3 tries \u00d7 3 s \u2192 kmaAddress name1\u20133",
      "width": 168
    },
    {
      "id": "location",
      "lane": "compose",
      "col": 1,
      "type": "backend",
      "label": "2. Query + params",
      "sublabel": "items 1\u20132 \u00b7 defaults, KR repair",
      "tag": "unit defaults \u00b7 name checks \u00b7 KR swap",
      "width": 168
    },
    {
      "id": "preload",
      "lane": "compose",
      "col": 2,
      "type": "database",
      "label": "3. Grid + preload",
      "sublabel": "item 3 \u00b7 grid + town/mid reads",
      "tag": "town and mid groups in parallel",
      "width": 168
    },
    {
      "id": "short",
      "lane": "read",
      "col": 2,
      "type": "backend",
      "label": "4. Forecast inputs",
      "sublabel": "items 4\u20136 \u00b7 short, RSS, shortest",
      "tag": "getShort \u00b7 getShortRss \u00b7 getShortest",
      "width": 168
    },
    {
      "id": "current",
      "lane": "read",
      "col": 3,
      "type": "backend",
      "label": "5. Correct current",
      "sublabel": "items 7\u201311 \u00b7 grid + station data",
      "tag": "current, history, station, opt-in ASOS",
      "width": 168
    },
    {
      "id": "timeline",
      "lane": "compose",
      "col": 3,
      "type": "backend",
      "label": "6. Align + correct",
      "sublabel": "items 12\u201315 \u00b7 24:00\u2192obs\u2192shortest",
      "tag": "observed\u2192short \u00b7 adjustShort",
      "width": 168
    },
    {
      "id": "daily",
      "lane": "compose",
      "col": 4,
      "type": "backend",
      "label": "7. Compose daily",
      "sublabel": "items 16\u201321 \u00b7 past+short+medium",
      "tag": "mid + past + short \u00b7 dailyStatus",
      "width": 168
    },
    {
      "id": "enrich",
      "lane": "read",
      "col": 4,
      "type": "backend",
      "label": "8. Enrich weather",
      "sublabel": "items 22\u201329 \u00b7 life, health, air",
      "tag": "+ sun \u00b7 insertIndex \u00b7 airInfoList",
      "width": 168
    },
    {
      "id": "presentation",
      "lane": "read",
      "col": 5,
      "type": "backend",
      "label": "9. Icons\u2192units\u2192text",
      "sublabel": "items 30\u201335 \u00b7 yesterday, warnings",
      "tag": "icons\u2192yesterday\u2192warnings\u2192units\u2192text",
      "width": 168
    },
    {
      "id": "response",
      "lane": "compose",
      "col": 5,
      "type": "frontend",
      "label": "10. KMA JSON",
      "sublabel": "items 36\u201337 \u00b7 conditional fields",
      "tag": "makeResult \u2192 sendResult res.json",
      "width": 168
    },
    {
      "id": "sink",
      "lane": "exits",
      "col": 0,
      "type": "frontend",
      "label": "Express error page",
      "sublabel": "next(err) \u2192 finalhandler 500",
      "tag": "coord2addr \u00b7 items 2, 30, 36",
      "width": 168,
      "yOffset": -4
    },
    {
      "id": "reject",
      "lane": "exits",
      "col": 1,
      "type": "frontend",
      "label": "400 text/html",
      "sublabel": "We didn't support this region",
      "tag": "4 region names \u00b7 town JP",
      "width": 168,
      "yOffset": -4
    },
    {
      "id": "redirect",
      "lane": "exits",
      "col": 2,
      "type": "frontend",
      "label": "302 redirect",
      "sublabel": "API_SERVER /weather/coord",
      "tag": "outside Korea box \u00b7 query copied",
      "width": 168,
      "yOffset": -4
    }
  ],
  "edges": [
