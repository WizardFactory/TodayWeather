{
  "_example": {
    "kind": "synthetic persisted client storage, current key set",
    "sourceRevision": "ff7acf3996ccb66c912d2ed4710cf300197d6966",
    "liveDeviceCapture": false,
    "encoding": "Values under localStorage are shown parsed. TwStorage.set stores JSON.stringify(value) under the key and, when the appPreferences plugin exists, schedules the same string for the native suite <app-group> (see docs/rewrite/configuration-inventory.md section 4).",
    "omittedKeys": {
      "storeReceipt": "plugin receipt envelope; sensitive",
      "daumServiceKeys": "configured provider key list; sensitive configuration",
      "pushData": "legacy push key; see storage-legacy.json"
    },
    "sensitiveFields": "fcmToken and registrationId are null on purpose. No token, receipt, device ID or credential appears in this file.",
    "truncation": "City weather members keep only their structure; see client-kma-normalized.json for a complete normalized city.",
    "timezone": "Push Date fields are ISO instants created on 2026-09-20 in Asia/Seoul (UTC+9): alert 07:00-22:00, alarms 07:40 and 20:20 local.",
    "deliberateDefects": [
      "pushData2.pushList[0] (cityIndex 0) carries a stale name/location/town; loadPushInfo replaces them from cities[0].",
      "pushData2.pushList[2] has a location without lat; loadPushInfo re-derives it from cities[1]."
    ],
    "reference": "docs/rewrite/client-state-and-behavior.md (Persisted record shapes)",
    "pushListNote": "pushList is shortened: PushCtrl's first save for a city writes its alert plus two default alarms, and later saves never remove alarms, so the cityIndex 0 alarms a real save would contain are omitted here."
  },
