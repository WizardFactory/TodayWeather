    "kind": "synthetic persisted client storage, legacy keys before migration",
    "sourceRevision": "ff7acf3996ccb66c912d2ed4710cf300197d6966",
    "liveDeviceCapture": false,
    "encoding": "rawLocalStorage values are the exact strings returned by localStorage.getItem (the migration reads these keys without JSON.parse). jsonLocalStorage values are shown parsed; they are read through TwStorage.get (JSON.parse).",
    "absentKeys": [
      "settingsInfo",
      "startVersion",
      "cityList",
      "pushData2"
    ],
    "sensitiveFields": "pushData.registrationId is null on purpose. No token, receipt, device ID or credential appears in this file.",
    "unknownLegacyWriters": "The code that wrote startupPage, refreshInterval, guideVersion and pushData.alarmList is not in this checkout. Legacy alarm fields other than cityIndex and time are unknown; the migration keeps any extra fields unchanged.",
    "migrationPreconditions": "guideVersion and startupPage/refreshInterval migrate only when the appPreferences plugin exists and localStorage is non-empty (TwStorage.init -> _setBackwardCompatibility). The pushData migration runs on every start while pushData2 is absent or unparsable; aircn replacement and cities repair run on every start.",
    "deliberateCases": [
      "cities[0] is an old current-position placeholder without disable/photo; createCity defaults disable to false.",
      "cities[1] is an address-only favorite without location or name, with the legacy dayTable slot.",
      "units.airUnit is the retired value aircn."
    ],
    "reference": "docs/rewrite/client-state-and-behavior.md (Legacy migrations)"
  },
