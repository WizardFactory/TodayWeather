  "cards": [
    {
      "dot": "cyan",
      "title": "Policy · issue #2654",
      "items": [
        "First show waits for config finish (max 12 seconds)",
        "Cache survives offline; screen hiding / consent win"
      ]
    },
    {
      "dot": "amber",
      "title": "Separate consent gates · #2660",
      "items": [
        "Analytics off until opt-in; advertising uses denied",
        "UMP controls ads; withdrawal stops future analytics"
      ]
    },
    {
      "dot": "rose",
      "title": "iOS tracking · #2945",
      "items": [
        "UMP owns the ATT prompt; the app never asks",
        "Personalized only if ATT and consent allow"
      ]
    }
  ]
}
