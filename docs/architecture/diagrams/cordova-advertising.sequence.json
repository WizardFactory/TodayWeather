    },
    {
      "id": "init",
      "from": "screen",
      "to": "ads",
      "y": 210,
      "label": "Tab initializes ads",
      "variant": "emphasis"
    },
    {
      "id": "config",
      "from": "ads",
      "to": "policy",
      "y": 255,
      "label": "Load banner policy",
      "variant": "default"
    },
    {
      "id": "adapter-init",
      "from": "ads",
      "to": "adapter",
      "y": 300,
      "label": "Initialize adapter",
      "variant": "default"
    },
    {
      "id": "consent",
