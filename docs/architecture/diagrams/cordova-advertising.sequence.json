      "label": "TwAds",
      "sublabel": "Visibility state"
    },
    {
      "id": "policy",
      "type": "backend",
      "label": "Monetization",
      "sublabel": "Remote Config / GA4"
    },
    {
      "id": "adapter",
      "type": "backend",
      "label": "AdMob adapter",
      "sublabel": "Consent / reload gate"
    },
    {
      "id": "native",
      "type": "external",
      "label": "Native AdMob",
      "sublabel": "When available"
    }
  ],
  "messages": [
