      "from": "adapter",
      "to": "native",
      "y": 570,
      "label": "Request: npa unless ATT allowed",
      "variant": "default"
    },
    {
      "id": "telemetry",
      "from": "adapter",
      "to": "policy",
      "y": 615,
      "label": "Diagnostics after opt-in",
      "variant": "default"
    }
