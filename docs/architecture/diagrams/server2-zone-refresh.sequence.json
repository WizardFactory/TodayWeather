  "cards": [
    {
      "dot": "amber",
      "title": "Proposed contract, not runtime evidence",
      "items": [
        "Pinned parent marks requested at start; this design moves success after readable publication.",
        "Error, None, panic, empty or malformed result leaves retry eligibility.",
        "No new timer, pre-collection, mode or operating allowance."
      ]
    },
    {
      "dot": "emerald",
      "title": "Preserve the existing owner",
      "items": [
        "One forecast-zones flight; immediate request wait and original owned lifetime.",
        "Five-minute monotonic admission is claimed only by the flight creator.",
        "Caller cancellation does not cancel acquisition; success stops process refresh."
      ]
    },
    {
      "dot": "slate",
      "title": "S3 remains authoritative",
      "items": [
        "Failed refresh retains last-good memory; complete published list invalidates it.",
        "Existing ten-minute incremental refresh and daily refold are unchanged.",
        "D2 capacity, live providers, quota, whole-service readiness and shadow are not qualified."
      ]
    }
  ]
