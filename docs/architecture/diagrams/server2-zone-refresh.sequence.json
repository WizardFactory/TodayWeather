  "cards": [
    {
      "dot": "cyan",
      "title": "Newest list, answer level",
      "items": [
        "Answers use only the newest complete list’s active zones (AK 2026-11-10).",
        "No fold since 202601, no daily refold, no per-process success latch.",
        "Corrupt or transport errors keep today’s handling; nothing readable gives the packaged zones."
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded restart read",
      "items": [
        "One LIST page per 1,000 partitions, one catalog per partition examined, one descriptor and its pages per tried group.",
        "Identical lists in older partitions are never read.",
        "A list of day D−2 or older cannot complete after one of day D (200 s provider budget)."
      ]
    },
    {
      "dot": "amber",
      "title": "Freshness",
      "items": [
        "Acquire when the newest identity is older than 24 h or nothing is stored.",
        "One owned flight and the five-minute claim are unchanged.",
        "Re-confirming the same identity only updates the check time."
      ]
    }
