  "cards": [
    {
      "dot": "cyan",
      "title": "Change detection (decision 6)",
      "items": [
        "getPwnStatus, getWthrPwn, getWthrInfo and getWthrBrkNews every cycle.",
        "A new tmFc/tmSeq calls getWthrWrnMsg and getPwnCd; stays pending while either lags.",
        "getPwnCd windows overlap and resync hourly; quota errors stop the cycle."
      ]
    },
    {
      "dot": "amber",
      "title": "Replay rules (decision 7)",
      "items": [
        "Commands 1/3/6/7 set active, 2/8 clear, allEndTime clears the zone.",
        "Newest event per zone and warnVar wins; cancelled rows are ignored.",
        "Empty state bootstraps 60 days; drift from t6 is logged."
      ]
    },
    {
      "dot": "amber",
      "title": "Town mapping (decisions 8, 9)",
      "items": [
        "City/county zone plus sub-zones; split parents over-warn.",
        "warnVar → weather code, warnStress → 주의보/경보/중대경보."
      ]
    }
  ]
