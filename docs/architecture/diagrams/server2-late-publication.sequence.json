  "cards": [
    {
      "dot": "amber",
      "title": "Proposed contract, not execution proof",
      "items": [
        "One cell / latest Short: provision +2, +5, +10 minutes; no timer or pre-collection.",
        "Late first demand uses one elapsed slot, without replaying missed windows.",
        "Current cited gate is expiry-only; finite-slot implementation is still planned."
      ]
    },
    {
      "dot": "emerald",
      "title": "Bounded process-local ownership",
      "items": [
        "At most 65,536 cells for the newest admitted publication; newer base resets the map.",
        "Older publication or repeated/lower slot is refused after clock rollback.",
        "Concurrent callers join the existing flight; cancellation does not cancel its owner."
      ]
    },
    {
      "dot": "slate",
      "title": "Preserved boundaries",
      "items": [
        "Stored usable inputs prevent acquisition; original response/wait deadline stays.",
        "Historical backfill and other families retain their existing admission.",
        "B2 charges actual HTTP attempts; no durable global quota, operating allowance or readiness claim."
      ]
    }
  ]
