  "cards": [
    {
      "dot": "cyan",
      "title": "Client recovery boundary",
      "items": [
        "Only Mongo is read for AirKorea data; no client-triggered AirKorea API request.",
        "Fresh province averages remain authoritative. Missing or unusable provinces use representative points.",
        "Same domestic global-air service, cache, provider order and budgets."
      ]
    },
    {
      "dot": "amber",
      "title": "Bounded parallel work",
      "items": [
        "At most four points concurrently; one response deadline includes DB lookup.",
        "Completed results stay immutable; in-flight chains may still fill shared cache.",
        "Partial air and explicit status retain weather; point data never enters AirKorea collections."
      ]
    },
    {
      "dot": "cyan",
      "title": "Design and implementation",
      "items": [
        "Base citations identify the existing integration points; issue 2636 adds the nation fallback.",
        "Implementation: lib/air/nationAir.js, tested with local Mongo and loopback providers.",
        "Operating key is expired; scheduled AirKorea recovery awaits separate renewal and rollout."
      ]
    }
  ]
