      "title": "Settings and token changes",
      "items": [
        "POST /v000902/push-list saves alarm / alert settings.",
        "PUT /v000902/push replaces old + new tokens; DELETE removes settings."
      ]
    },
    {
      "dot": "emerald",
      "title": "Independent background jobs",
      "items": [
        "Alarm: every minute; match UTC time and local weekday.",
        "Alert: UTC minutes 7 / 17 / 35 / 50; time window and rain / air rules.",
        "FCM / APNs initialize on first send; APNs callback awaits SDK result."
      ]
    },
