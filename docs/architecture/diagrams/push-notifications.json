  "cards": [
    {
      "dot": "cyan",
      "title": "Settings and token changes",
      "items": [
        "POST /v000902/push-list saves alarm / alert settings on tw-svc.",
        "PUT /v000902/push moves every record of the old token; DELETE by city.",
        "Ten service workers write one SQLite file: async lock, temp file, rename."
      ]
    },
    {
      "dot": "emerald",
      "title": "One delivery process on tw-svc",
      "items": [
        "Alarm: every minute; match UTC time and local weekday.",
        "Alert: UTC minutes 7 / 17 / 35 / 50; window and 6-hour repeat guard.",
        "No MongoDB connection with PUSH_STORE=sqlite; FCM on first send."
      ]
    },
    {
      "dot": "rose",
      "title": "Switch, rollback and limits",
      "items": [
        "PUSH_STORE=sqlite + PUSH_DB_PATH; unset to return to MongoDB.",
        "Existing Mongo records are not imported; clients re-post on launch.",
        "Deployment, Firebase credentials and device delivery unverified."
      ]
    }
  ]
