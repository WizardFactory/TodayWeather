  "cards": [
    {
      "dot": "amber",
      "title": "Design3 at the pinned base",
      "items": [
        "Existing hooks are cited at2e67d146; this is the selected optimization contract, not current-code or execution proof.",
        "Prior Shared-future prototype passed local checks but its actual batching gain was only132requests; its lifecycle is not selected."
      ]
    },
    {
      "dot": "emerald",
      "title": "Fresh admission stays per caller",
      "items": [
        "One poll advisory view only filters candidates before claims. Post-claim and after-own-OAuth reads are independent fresh strict acquisitions.",
        "Keep zero OAuth on post-claim state failure, the original four-second final guard, current journal/clock/window and FCM stopping checks. No shared in-flight join, fill timer or detached task."
      ]
    },
    {
      "dot": "rose",
      "title": "Local memo; durable authority",
      "items": [
        "Only known Owned/Taken physical claim identities enter the bounded memo, before another await. Unavailable is not ownership.",
        "Full memo falls back to ordinary CAS for new endpoints. Claims never release; actual failed/unknown sends never retry. At most six delivery futures are constructed at once."
      ]
    },
    {
      "dot": "cyan",
      "title": "Measured scope and remaining gates",
      "items": [
        "Actual complete-seed/fixed-clock5000 baseline:195002first S3requests,65001onrepeat; all5000accepted/results.",
        "Keep the frozen first-pass126000S12 maximum and0repeatendpointwork; simplifiedcandidate must rerun the same harness. These are local fixture bounds, not60day/realhost capacity.",
        "No globally atomic warning snapshot, newTTL, production/shadow qualification or merge."
      ]
    }
  ]
