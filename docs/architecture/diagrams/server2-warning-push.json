  "cards": [
    {
      "dot": "emerald",
      "title": "Legacy source contract",
      "items": [
        "First durable feed is silent; later new source events must be less than five minutes old.",
        "Release, expiry, active announcement, alert time window and zone govern selection."
      ]
    },
    {
      "dot": "rose",
      "title": "One-shot implementation",
      "items": [
        "Endpoint claim before one submission; failed or unknown work is never retried.",
        "Startup baseline consumes old feed without broadcasting or resuming delivery."
      ]
    },
    {
      "dot": "slate",
      "title": "Activation boundary",
      "items": [
        "S12 feeds only rows with acknowledged raw and catalog publication.",
        "S20 owns process wiring. Synthetic HTTP acceptance is not device delivery."
      ]
    }
  ]
