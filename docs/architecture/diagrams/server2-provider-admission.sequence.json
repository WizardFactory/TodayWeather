{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "DataGoKr Selected Funding Contract",
    "output": "docs/architecture/diagrams/server2-provider-admission.html",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "legend": {
      "entries": {
        "default": {
          "label": "Acquisition"
        },
        "emphasis": {
          "label": "Funded HTTP"
        },
        "security": {
          "label": "Funding admission"
        },
        "dashed": {
          "label": "Conditional S3 work"
        },
        "return": {
          "label": "Result"
        }
      }
    }
  },
  "participants": [
    {
      "id": "caller",
      "type": "external",
      "label": "Acquirer",
      "sublabel": "key ring owner"
    },
    {
      "id": "executor",
      "type": "backend",
      "label": "Executor",
      "sublabel": "two HTTP maximum"
    },
    {
      "id": "budget",
      "type": "security",
      "label": "Budget store",
      "sublabel": "per key / API"
    },
    {
      "id": "s3",
      "type": "database",
      "label": "S3 authority",
      "sublabel": "durable ownership"
    },
    {
      "id": "provider",
      "type": "cloud",
      "label": "Provider",
      "sublabel": "DataGoKr API"
    }
  ],
  "messages": [
    {
      "id": "call",
      "from": "caller",
      "to": "executor",
      "y": 160,
      "label": "Acquire page; caller deadline",
      "variant": "default"
    },
    {
      "id": "fund-a",
      "from": "executor",
      "to": "budget",
      "y": 200,
      "label": "Reserve key A: one unit",
      "variant": "security"
    },
    {
      "id": "check-a",
      "from": "budget",
      "to": "s3",
      "y": 240,
      "label": "Reconcile A if needed",
      "variant": "dashed"
    },
    {
      "id": "no-a",
      "from": "s3",
      "to": "budget",
      "y": 280,
      "label": "Authority at A ceiling",
      "variant": "return"
    },
    {
      "id": "skip-a",
      "from": "budget",
      "to": "executor",
      "y": 320,
      "label": "Known Exhausted; no HTTP on A",
      "variant": "return"
    },
    {
      "id": "fund-b",
      "from": "executor",
      "to": "budget",
      "y": 360,
      "label": "Reserve selected B: one unit",
      "variant": "security"
    },
    {
      "id": "claim-b",
      "from": "budget",
      "to": "s3",
      "y": 400,
      "label": "Claim B block / witness if needed",
      "variant": "security"
    },
    {
      "id": "owned-b",
      "from": "s3",
      "to": "budget",
      "y": 440,
      "label": "Ownership acknowledged",
      "variant": "return"
    },
    {
      "id": "reservation-b",
      "from": "budget",
      "to": "executor",
      "y": 480,
      "label": "Owned reservation B",
      "variant": "return"
    },
    {
      "id": "consume-b",
      "from": "executor",
      "to": "budget",
      "y": 520,
      "label": "Consume B unit; no refund",
      "variant": "security"
    },
    {
      "id": "http-b",
      "from": "executor",
      "to": "provider",
      "y": 560,
      "label": "HTTP using funded B only",
      "variant": "emphasis"
    },
    {
      "id": "result",
      "from": "provider",
      "to": "executor",
      "y": 600,
      "label": "Valid data / no-data",
      "variant": "return"
    },
    {
      "id": "reply",
      "from": "executor",
      "to": "caller",
      "y": 640,
      "label": "Result; B attempted, A exhausted",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Selected attempt contract",
      "items": [
        "A funded first-key success never requests unused B funding",
        "Only known Exhausted permits trying the distinct next candidate",
        "At most two HTTP attempts per executor call; one caller deadline"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure and accounting",
      "items": [
        "Unknown, corrupt or transport funding failure stops without rotation",
        "Local exhaustion stays separate from funded HTTP attempts and provider outcomes",
        "S08 authority claims can exceed logical units; no refunds or state rewind"
      ]
    },
    {
      "dot": "amber",
      "title": "Proposed contract, not execution evidence",
      "items": [
        "This sequence shows the A-exhausted / B-success example, not a code-revision attestation",
        "The acquirer retains the actual working key using its existing parallel-safe update",
        "VisualCrossing maximum prepayment and allowance values remain unchanged"
      ]
    }
  ]
}
