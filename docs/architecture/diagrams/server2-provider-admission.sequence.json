  "cards": [
    {
      "dot": "emerald",
      "title": "Ceiling and ownership",
      "items": [
        "CAS high-water allocates non-overlapping ranges; a durable witness precedes private subdivision.",
        "Every configured key maximum is funded before HTTP. Policy/window identity is trusted configuration."
      ]
    },
    {
      "dot": "rose",
      "title": "Replacement and uncertainty",
      "items": [
        "Unknown writes, abandoned reservations and unused prior-host blocks are never refunded.",
        "No HTTP without verified admission. An uncommitted write with no durable record cannot be discovered."
      ]
    },
    {
      "dot": "amber",
      "title": "Scope and cost",
      "items": [
        "New block: GET + CAS PUT + witness PUT. Warm owned block: no extra S3 funding request.",
        "This proposed internal contract is not live AWS/IAM/quota verification or a deployed provider route."
      ]
    }
  ]
