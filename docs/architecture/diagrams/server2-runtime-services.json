  "cards": [
    {
      "dot": "cyan",
      "title": "Scheduling and admission",
      "items": [
        "Ordinary push selection; no startup weather precollection.",
        "Observe UTC minutes; reject stale queued ticks, never catch up.",
        "After OAuth: current subscription/time/zones and final stop gate."
      ]
    },
    {
      "dot": "amber",
      "title": "Selected cancellation deadline",
      "items": [
        "Push writer or delivery: shared 34s drain + up to 1s teardown.",
        "Neither present: shared HTTP-only 5s drain + up to 1s teardown.",
        "Long owned acquisitions remain incomplete; durable claims prevent replay."
      ]
    },
    {
      "dot": "amber",
      "title": "Public warning boundary",
      "items": [
        "Explicit kma selects v000903 special before the direct KMA mount.",
        "Internal push / older-KMA warning storage does not expose this API.",
        "Existing S12 service and bounded store; no new acquisition or send loop."
      ]
    }
  ]
