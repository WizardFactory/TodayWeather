  "cards": [
    {
      "dot": "cyan",
      "title": "Production coverage before runtime",
      "items": [
        "Without explicit legacy: require all8 native selections and all3 world versions.",
        "Missing coverage stops before services, state, listeners or providers.",
        "Explicit coexistence keeps existing origin/provider validation.",
        "Shared code-injected partial/foundation construction is unchanged.",
        "AK E2: complete env-only settings allowed without .env; mandatory settings still required."
      ]
    },
    {
      "dot": "cyan",
      "title": "Scheduling and admission",
      "items": [
        "Push startup parses active TW and configured TA accounts before state work.",
        "No OAuth / FCM probe at startup; low-level sends retain their error mapping.",
        "After OAuth: current subscription/time/zones and final stop gate."
      ]
    },
    {
      "dot": "amber",
      "title": "Selected cancellation deadline",
      "items": [
        "Push writer or delivery: shared 34s drain + up to 1s teardown.",
        "Neither present: shared HTTP-only 5s drain + up to 1s teardown.",
        "Long owned acquisitions remain incomplete; durable claims prevent replay."
      ]
    },
    {
      "dot": "amber",
      "title": "Public warning boundary",
      "items": [
        "Explicit kma selects v000903 special before direct KMA dispatch.",
        "Internal push / older KMA storage does not expose this public API.",
        "C5 source-owned acquisition is separate; initial delivery baseline stays silent."
      ]
    },
    {
      "dot": "cyan",
      "title": "Local validation boundary",
      "items": [
        "Absent retired TodayAir is allowed; active TodayWeather is mandatory.",
        "Parsed accounts stay cached; restart for rotation, no remote-auth proof.",
        "Disabled push reads no Firebase account settings or files."
      ]
    },
    {
      "dot": "amber",
      "title": "Writer availability boundary",
      "items": [
        "ready requires restored state and the existing writer receiver to remain open.",
        "Normal close or writer panic makes availability false; no second task owner.",
        "Receiver closure can precede drain completion; false is not a writer-join receipt.",
        "Full readiness endpoint and S3 / credential-source health remain open E3 work."
      ]
    },
    {
      "dot": "amber",
      "title": "Warning poll task ownership",
      "items": [
        "Only the matching warning job completion or failed join releases its poll slot.",
        "Alarm or alert failures cannot release live warning work; one JoinSet owns the jobs.",
        "A pending regular tick may run after completion; stop still blocks new scheduling.",
        "Original task failure stays incomplete; no failed / unknown send replay or state rewind."
      ]
    },
    {
      "dot": "cyan",
      "title": "CPU lifetime and typed failures",
      "items": [
        "10ms completion margin; no CPU permit over provider/S3 IO.",
        "Queued cancellation releases offer; admitted closure owns permits until exit.",
        "Post-funded local loss: private2s cooldown, no provider penalty or next attempt.",
        "After possible writes, CPU loss stays ambiguous; no resend authority."
      ]
    },
    {
      "dot": "amber",
      "title": "Finite private evidence boundary",
      "items": [
        "Fixed labels and buckets; cap2048series /4096u64 /512KiB.",
        "Operation counts precede log filtering, rate limits and queue loss.",
        "S3 bytes are logical; HTTP duration ends at headers.",
        "Local KMA/warning/AirKorea and D2/F2 reconciliation remain outside CPU sharing.",
        "Sources pin the actual committed runtime; no production topology or host qualification."
      ]
    }
  ]
