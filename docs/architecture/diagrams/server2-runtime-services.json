  "cards": [
    {
      "dot": "cyan",
      "title": "Scheduling and admission",
      "items": [
        "Ordinary push selection; no startup weather precollection.",
        "Observe UTC minutes; reject stale queued ticks, never catch up.",
        "After OAuth: current subscription/time/zones and final stop gate."
      ]
    },
    {
      "dot": "amber",
      "title": "One 35-second cancellation envelope",
      "items": [
        "34s shared HTTP/job/writer deadline + 1s runtime teardown.",
        "Long owned acquisitions may remain incomplete and are cancelled.",
        "Durable claims survive failed/unknown/cancelled sends; no replay."
      ]
    }
  ]
