      "dot": "amber",
      "title": "Persistence and lifecycle",
      "items": [
        "Push and notice also use the one bounded S3 transport.",
        "Warning feed accepts successful durable publications only.",
        "S20b owns supervised delivery stop; 5s HTTP drain is not full drain."
      ]
