  "cards": [
    {
      "dot": "emerald",
      "title": "Contract",
      "items": [
        "Lookups overlap; results are consumed in partition order, so Docs, order and errors equal the sequential read.",
        "Store admission rises 2 to 12 (raw loads too); per-lookup output falls 32 to 4 MiB and controls 8 to 1 MiB: in-flight reads of all views stay within 72.75 MiB (D2: 82.125 MiB).",
        "No new mode, timer, retry or provider call."
      ]
    },
    {
      "dot": "emerald",
      "title": "Preserved",
      "items": [
        "Owner deadline, 3 second waiter, writer fences and install rules are unchanged; the next owner wakes after the workspace returns.",
        "The 12-permit process S3 gate is shared with other families and is not resized here.",
        "Every capacity cap keeps its exact boundary."
      ]
    },
    {
      "dot": "slate",
      "title": "Loopback evidence",
      "items": [
        "130 partitions at 10 ms per operation: 0.55 s with 12 lookups in flight, 3.9 s sequential.",
        "Local, modeled 10 ms: views ready after 3.1 s in a running server (D2: none within its 8 s owner bound); the 3 s deadline is still missed.",
        "Seoul t3.small: views ready after 4.6 s even at 0 ms (D2: about 3 of 7 by its 8 s bound); fold CPU sets the floor. Real S3 and TLS are not measured."
      ]
    }
  ]
