{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Stored air forecast selection",
    "output": "docs/architecture/diagrams/air-forecast-selection.html",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      670
    ],
    "subtitle": "Legacy stored forecasts with independent current-observation provenance"
  },
  "participants": [
    {
      "id": "client",
      "type": "frontend",
      "label": "Installed app",
      "sublabel": "airForecastSource=kaq"
    },
    {
      "id": "route",
      "type": "backend",
      "label": "Town24h route",
      "sublabel": "AirForecast / AirForecastList"
    },
    {
      "id": "stations",
      "type": "database",
      "label": "Station metadata",
      "sublabel": "existing nearby lookup"
    },
    {
      "id": "kaq",
      "type": "database",
      "label": "KAQ store",
      "sublabel": "same station"
    },
    {
      "id": "airkorea",
      "type": "database",
      "label": "AirKorea store",
      "sublabel": "same station"
    }
  ],
  "segments": [
    {
      "from": 146,
      "to": 270,
      "label": "Retain station"
    },
    {
      "from": 280,
      "to": 456,
      "label": "Select stored forecast"
    },
    {
      "from": 468,
      "to": 550,
      "label": "Enrich response"
    }
  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "route",
      "y": 160,
      "label": "weather request",
      "variant": "emphasis"
    },
    {
      "id": "nearby",
      "from": "route",
      "to": "stations",
      "y": 200,
      "label": "existing nearby query"
    },
    {
      "id": "station",
      "from": "stations",
      "to": "route",
      "y": 240,
      "label": "retain named station",
      "variant": "return"
    },
    {
      "id": "read-kaq",
      "from": "route",
      "to": "kaq",
      "y": 300,
      "label": "KAQ requested: station forecast"
    },
    {
      "id": "kaq-result",
      "from": "kaq",
      "to": "route",
      "y": 340,
      "label": "usable KAQ wins; otherwise try AirKorea",
      "variant": "return"
    },
    {
      "id": "read-airkorea",
      "from": "route",
      "to": "airkorea",
      "y": 390,
      "label": "fallback or explicit/default AirKorea",
      "variant": "emphasis"
    },
    {
      "id": "airkorea-result",
      "from": "airkorea",
      "to": "route",
      "y": 430,
      "label": "usable stored rows or no data",
      "variant": "return"
    },
    {
      "id": "response",
      "from": "route",
      "to": "client",
      "y": 500,
      "label": "unchanged current + selected forecast",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Verified station and future window",
      "items": [
        "AirKorea current: observation station; other providers: retained nearby metadata. No station: current-only.",
        "Finite nonnegative supported values; KST after now/current. AirKorea: observation +24 h; fallback: request-hour +24 h."
      ]
    },
    {
      "dot": "amber",
      "title": "Source and compatibility",
      "items": [
        "Keep current source, readings and attribution. Set forecastStationName and actual forecast source/publication only for usable future rows.",
        "Valid partial KAQ stays; explicit/default AirKorea shares validation. No usable source: no invented values; no new provider calls or writes."
      ]
    }
  ]
}
