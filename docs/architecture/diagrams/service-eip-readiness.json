{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Proposed Spot readiness failure notification",
    "subtitle": "Local design; production wiring is not deployed",
    "output": "docs/architecture/diagrams/service-eip-readiness.html",
