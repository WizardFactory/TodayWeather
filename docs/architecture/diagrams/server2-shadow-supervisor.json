  "cards": [
    {
      "dot": "cyan",
      "title": "Scoped contract",
      "items": [
        "Original epoch: 168h collection, 170h host expiry",
        "One initial process; resume never uploads twice",
        "One cumulative cost ceiling (USD 300) priced from measured counters"
      ]
    },
    {
      "dot": "rose",
      "title": "Accounting and evidence",
      "items": [
        "Guard stops with cost_ceiling when estimate + finish reserve reach the ceiling",
        "Control envelopes and cleanup budgets are separate",
        "Missing original linkage stays incomplete; no live PASS"
      ]
    },
    {
      "dot": "violet",
      "title": "Host logs (LP-6)",
      "items": [
        "Candidate, guard and reader write to the server2 journal namespace; the collector ships them to logs/server2 in the run's state bucket.",
        "Server records at warn and above; guard and reader only as JSON objects; no URL, body or key.",
        "The collector never starts, stops or delays acquisition; the retention stop drains it before export."
      ]
    },
    {
      "dot": "amber",
      "title": "Evidence copy (SR-5a)",
      "items": [
        "A host timer copies completed attempts' bodies, a consistent ledger snapshot and the run contract to evidence/ in the state bucket at least hourly; an index object commits each generation.",
        "After the reader stops (any stop path or the 168h stop) a finalizer takes a final generation; it never delays the 170h poweroff.",
        "The bucket alone proves the evidence: pending attempts and capture failures are reported, not counted as missing."
      ]
    },
    {
      "dot": "cyan",
      "title": "Resumable finish",
      "items": [
        "Resume into the original private output directory and retain verified version receipts.",
        "After the exact instance is terminated, seal the version inventory before cleanup.",
        "At the deadline, keep the state bucket without expiry when evidence export remains incomplete."
      ]
    },
    {
      "dot": "amber",
      "title": "SR-7 offline decision",
      "items": [
        "Read the private finish directory and frozen criteria. Write the report to a new file.",
        "SR-6 local-peer replay: C1 passed integrity checks. C2 through C8 remain unassessed. Recommendation: hold.",
        "A short cloud canary and a week-long run each require a separate approval."
      ]
    }
  ]
