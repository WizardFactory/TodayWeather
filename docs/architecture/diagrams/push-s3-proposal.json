      "dot": "cyan",
      "title": "S3 is persistence",
      "items": [
        "One device record per object",
        "No S3 reads for each recipient"
      ]
    },
    {
      "dot": "amber",
      "title": "Latest received location",
      "items": [
        "No expiry by location age",
        "Recheck before provider submission"
      ]
    },
    {
      "dot": "rose",
      "title": "Burst delivery first",
      "items": [
        "Reserve capacity for warnings",
        "Measure acceptance and receipt separately"
      ]
    },
    {
      "dot": "emerald",
      "title": "Preparation failures retry",
      "items": [
        "Typed weather error, bounded backoff before FCM",
        "Campaign records stage, reason and attempt counts only"
      ]
    },
    {
      "dot": "amber",
      "title": "Bounded transport recovery",
      "items": [
        "Never replay an ambiguous request; retain its physical slot",
        "Wait 30s; at most two fresh-job probes while sends remain unresolved"
      ]
    },
    {
      "dot": "rose",
      "title": "Observe transport separately",
      "items": [
        "Registration readiness does not imply transport readiness",
        "Authentication or exhausted probes require operator recovery"
      ]
    }
  ]
