{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Coordinate air-quality forecast",
    "output": "docs/architecture/diagrams/coordinate-air-forecast.html",
    "viewBox": [1080, 680],
    "column_fit": "spread",
    "quality_profile": "showcase"
  },
  "participants": [
    {"id": "app", "type": "frontend", "label": "Web and native apps", "sublabel": "Viewed weather coordinates"},
    {"id": "server", "type": "backend", "label": "server1", "sublabel": "Public coordinate gateway"},
    {"id": "budget", "type": "database", "label": "MongoDB", "sublabel": "Shared provider budgets"},
    {"id": "google", "type": "external", "label": "Google", "sublabel": "Air Quality API"},
    {"id": "owm", "type": "external", "label": "OpenWeather", "sublabel": "Air Pollution API"}
  ],
  "messages": [
    {"id": "weather", "from": "app", "to": "server", "y": 163, "label": "GET coordinate weather", "variant": "emphasis"},
    {"id": "availability", "from": "server", "to": "app", "y": 200, "label": "Weather and availability signal", "variant": "return"},
    {"id": "forecast", "from": "app", "to": "server", "y": 250, "label": "GET coordinate air forecast", "variant": "emphasis"},
    {"id": "reserve-google", "from": "server", "to": "budget", "y": 282, "label": "Reserve Google allowance", "variant": "default"},
    {"id": "fetch-google", "from": "server", "to": "google", "y": 317, "label": "Request next 24 hours if admitted", "variant": "default"},
    {"id": "google-result", "from": "google", "to": "server", "y": 350, "label": "Valid UTC hours or no usable data", "variant": "return"},
    {"id": "reserve-openweather", "from": "server", "to": "budget", "y": 384, "label": "Reserve alternate allowance on miss", "variant": "default"},
    {"id": "fetch-openweather", "from": "server", "to": "owm", "y": 420, "label": "Request OpenWeather if admitted", "variant": "default"},
    {"id": "openweather-result", "from": "owm", "to": "server", "y": 455, "label": "Alternate UTC hours or no usable data", "variant": "return"},
    {"id": "result", "from": "server", "to": "app", "y": 505, "label": "no-store: forecast or unavailable", "variant": "return"}
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Forecast budgets",
      "items": [
        "A separate request uses a free allowance reservation before a provider call.",
        "The source, attribution and original AQI scale travel with the rows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Storage and geography",
      "items": [
        "Forecast data stay outside persistent place weather. Clients use the viewed time zone.",
        "Korean station forecasts continue through the existing KAQ and AirKorea paths."
      ]
    }
  ]
}
