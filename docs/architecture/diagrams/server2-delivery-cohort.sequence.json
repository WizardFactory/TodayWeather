  "cards": [
    {
      "dot": "cyan",
      "title": "Proposal, not implementation",
      "items": [
        "Source links pin existing interfaces at e97a5090; the receipt and observed-apply protocol are proposed, not present in that code.",
        "Child lateness is a separate reviewed slice. No parent compensation tests or full release qualification are claimed.",
        "Sequence phases: proposed confirmed ownership; definite no-POST branch only; preserve newer state and claims."
      ]
    },
    {
      "dot": "amber",
      "title": "Ownership, including ABA",
      "items": [
        "A writer-issued one-use receipt tracks only sending-channel derived leaves and exact stored presence.",
        "Every local commit and each caught-up journal change permanently invalidates superseded leaves; A-to-B-to-A cannot restore old ownership.",
        "Weak active leases are pruned; no per-record historical map, new persisted schema or repair timer."
      ]
    },
    {
      "dot": "rose",
      "title": "Actual POST outcomes do not enter recovery",
      "items": [
        "Accepted, Unregistered, Rejected and Unknown keep state and claims; never retry or undo them.",
        "Cancellation/panic without typed NotSent is uncertain external progress, not a compensation receipt.",
        "No receipt or uncertain writer/restore progress refuses POST and never reports successful state repair."
      ]
    },
    {
      "dot": "emerald",
      "title": "Required tests before acceptance",
      "items": [
        "Exercise OAuth refusal then a later fresh evaluation, while retaining the first minute claim.",
        "Prove metadata edits survive, exact missingness restores, newer leaves and intermediate journal ABA cannot be overwritten.",
        "Use an actual isolated executable/owned HTTP; preserve failure evidence and obtain independent review plus exact CI. No live sends or merge."
      ]
    }
  ]
