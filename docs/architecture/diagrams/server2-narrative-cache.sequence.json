  "cards": [
    {
      "dot": "amber",
      "title": "Proposed correction, not execution evidence",
      "items": [
        "Current committed interface flattens a failed read into cached absence.",
        "The proposed path omits the failed request without writing a cache entry.",
        "Only completed Ok results can replace office memory."
      ]
    },
    {
      "dot": "emerald",
      "title": "Keep both valid cache outcomes",
      "items": [
        "Ok(Some fresh prose) and Ok(None confirmed absence) retain the existing 30-second cache.",
        "Each office keeps its own lock; deadline and narrative expiry stay unchanged.",
        "An expired prior value remains expired after failure; no stale-on-error behavior."
      ]
    },
    {
      "dot": "slate",
      "title": "Preserve accepted scope",
      "items": [
        "A late optional field may still be omitted for this request.",
        "No provider acquisition, timer, verification mode, allowance or storage schema change.",
        "Nation child-read optimization and whole-bundle rollback/shadow qualification remain separate."
      ]
    }
