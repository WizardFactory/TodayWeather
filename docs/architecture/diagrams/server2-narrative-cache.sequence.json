  "cards": [
    {
      "dot": "amber",
      "title": "Proposed correction to the minimal prototype",
      "items": [
        "The pinned prototype fixes false absence but has no repeated-error hold-back.",
        "Selected1s completed-error gate is distinct from30s confirmed presence or absence.",
        "No background retry timer or newly authorized production action."
      ]
    },
    {
      "dot": "emerald",
      "title": "Bound each office and recover",
      "items": [
        "Existing mutex permits one active read per office; gate blocks storage after completed faults.",
        "Read/lock retain their original deadline; attach caps optional work at the remaining time or2s.",
        "Successful read or refresh publication clears the error gate; expired answers stay expired."
      ]
    },
    {
      "dot": "slate",
      "title": "Disclose remaining limits",
      "items": [
        "Admitted reads retain existing2date/8page index and catalog/raw bounds, not measured host cost.",
        "Caller cancellation without a completed error is not cached as absence or manufactured failure.",
        "Nation child-read work, production capacity, whole-bundle recovery and shadow remain separate."
      ]
    }
  ]
