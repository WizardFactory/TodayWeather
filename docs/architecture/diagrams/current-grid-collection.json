{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Current grid collection design (#2648)",
    "locale": "en",
    "quality_profile": "showcase",
    "output": "docs/architecture/diagrams/current-grid-collection.html"
  },
  "lanes": [
    {
      "id": "control",
      "label": "Current collection"
    },
    {
      "id": "failure",
      "label": "Failure and retry eligibility",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "poll",
    "coverage",
    "pending",
    "fetch",
    "save",
    "readback",
    "done"
  ],
  "nodes": [
    {
      "id": "poll",
      "lane": "control",
      "col": 0,
      "type": "messagebus",
      "label": "Current poll",
      "sublabel": "existing six polls/hour",
      "width": 140
    },
    {
      "id": "coverage",
      "lane": "control",
      "col": 1,
      "type": "database",
      "label": "Read grid coverage",
      "sublabel": "DB1 / DB2 exact KST hour",
      "width": 140
    },
    {
      "id": "pending",
      "lane": "control",
      "col": 2,
      "type": "security",
      "label": "Pending grids",
      "sublabel": "all core fields validated",
      "width": 140
    },
    {
      "id": "fetch",
      "lane": "control",
      "col": 3,
      "type": "cloud",
      "label": "Bounded grid walk",
      "sublabel": "skip quota-rejected keys",
      "width": 140
    },
    {
      "id": "save",
      "lane": "control",
      "col": 4,
      "type": "database",
      "label": "Write observations",
      "sublabel": "existing grid models",
      "width": 140
    },
    {
      "id": "readback",
      "lane": "control",
      "col": 5,
      "type": "database",
      "label": "Verify coverage",
      "sublabel": "pending is an error",
      "width": 140
    },
    {
      "id": "done",
      "lane": "control",
      "col": 5,
      "type": "backend",
      "label": "Collection result",
      "sublabel": "UTC / KST metrics",
      "width": 140,
      "yOffset": 100
    },
    {
      "id": "quota",
      "lane": "failure",
      "col": 3,
      "type": "security",
      "label": "Daily quota stop",
      "sublabel": "current key until KST reset",
      "width": 140
    },
    {
      "id": "error",
      "lane": "failure",
      "col": 1,
      "type": "security",
      "label": "Read failed",
      "sublabel": "stop without HTTP",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "e0",
      "from": "poll",
      "to": "coverage",
      "label": "join"
    },
    {
      "id": "e1",
      "from": "coverage",
      "to": "pending",
      "label": "valid read"
    },
    {
      "id": "e2",
      "from": "coverage",
      "to": "error",
      "label": "DB error"
    },
    {
      "id": "e3",
      "from": "pending",
      "to": "fetch",
      "label": "missing only"
    },
    {
      "id": "e4",
      "from": "pending",
      "to": "done",
      "label": "all complete",
      "toSide": "left"
    },
    {
      "id": "e5",
      "from": "fetch",
      "to": "save",
      "label": "received"
    },
    {
      "id": "e6",
      "from": "save",
      "to": "readback",
      "label": "saved"
    },
    {
      "id": "e7",
      "from": "readback",
      "to": "done",
      "label": "coverage",
      "toSide": "top"
    },
    {
      "id": "e8",
      "from": "fetch",
      "to": "quota",
      "label": "quota"
    },
    {
      "id": "e9",
      "from": "quota",
      "to": "done",
      "label": "report pending",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Coverage contract",
      "items": [
        "Complete core fields; zero and negative temperatures are valid",
        "Stored grid observations only; station fallback never marks coverage"
      ]
    },
    {
      "dot": "amber",
      "title": "Scope and limits",
      "items": [
        "Process-local overlap and quota memory; restart is a new process",
        "No production activation, quota increase or historical backfill"
      ]
    }
  ]
}
