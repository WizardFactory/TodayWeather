  "cards": [
    {
      "dot": "cyan",
      "title": "Serving contract",
      "items": [
        "Preserve the observed client API contracts",
        "S3 is authoritative; RAM and disk copies are disposable",
        "Precise reverse-geocode keys and bodies stay volatile",
        "Verified raw disk cache is bounded and disposable"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durability and lookup",
      "items": [
        "Publish raw + complete catalogs before using new data",
        "Catalogs contain identities, not weather views",
        "Request-time KMA; older missing hours use nearest ASOS",
        "A request waits <=3s; detached shared acquisition continues"
      ]
    },
    {
      "dot": "amber",
      "title": "Scope and gates",
      "items": [
        "Proposed origin deployment; no route cutover claimed",
        "Cold cells acquire data; no steady-state legacy dependency",
        "Selected native KMA rejects all Forward markers; unknown towns and KR remaps resolve natively",
        "Verified raw disk cache is bounded and disposable; full-data cold latency remains unmeasured"
      ]
    },
    {
      "dot": "amber",
      "title": "World cold restoration",
      "items": [
        "One cell-owned outcome; failed restore retained3s, no empty Db or funded VC",
        "8s owner starts at admission; request waits at most3s, cancellation leaves owner",
        "Whole load32MiB/2048 fetches; four outputs include unconsumed completions",
        "32+4x32MiB is logical raw allowance, not RSS, host capacity or full recovery proof"
      ]
    }
  ]
