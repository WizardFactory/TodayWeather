  "cards": [
    {
      "dot": "emerald",
      "title": "Native error boundary",
      "items": [
        "Direct native routes preserve Express 400/404/500 status, body and HEAD headers.",
        "Gateway native non-200 replies and timeouts map to dependency errors without retrying legacy.",
        "Source failures, assembly defects and Rust panics increment the native-defect counter; no error fallback."
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy and ownership",
      "items": [
        "Precise reverse-geocode results and lookup history stay in bounded volatile RAM.",
        "S3 address caching is optional; coarse reverse labels require separate exact-parity proof.",
        "A waiter owns its response deadline, while a shared job owns its bounded acquisition and reservation."
      ]
    },
    {
      "dot": "amber",
      "title": "Coexistence is temporary",
      "items": [
        "Unselected families use legacy only during development and coexistence; no legacy dependency at go-live.",
        "Explicit unknown-town and KR-remap forwards still require removal in the next S15b-4b increment.",
        "Provider quotas, paired shadow, measured latency and AK cutover approval remain activation gates."
      ]
    }
  ]
