  "cards": [
    {
      "dot": "emerald",
      "title": "Durability gate",
      "items": [
        "Descriptor and bodies precede catalog CAS.",
        "New success verifies only the new complete group.",
        "No cross-object transaction is claimed."
      ]
    },
    {
      "dot": "rose",
      "title": "Partial publication",
      "items": [
        "New A + old B excludes the incomplete group.",
        "Keep complete groups accessible through bounded pages.",
        "Raw bodies alone do not acknowledge a result."
      ]
    },
    {
      "dot": "cyan",
      "title": "Repair and scope",
      "items": [
        "Only an exhausted, validated scan is complete.",
        "Healthy catalogs still need orphan reconciliation.",
        "Internal contract; no serving route is switched."
      ]
    },
    {
      "dot": "amber",
      "title": "Read bounds",
      "items": [
        "A checked page is not whole-history coverage.",
        "Targeted access avoids unrelated historical groups.",
        "Capacity is separate from corrupt data."
      ]
    }
  ]
