    {
      "dot": "cyan",
      "title": "Proposal and source boundary",
      "items": [
        "This proposal changes minute-expiry admission, not claim ownership or external retries.",
        "Source links pin existing interfaces at7659b9fa; they are not implementation or production proof."
      ]
    },
    {
      "dot": "amber",
      "title": "Time and window policy",
      "items": [
        "An already claimed list can finish after its first UTC minute; no extra member or stale catch-up.",
        "Alerts retain the same actual admitted configured window occurrence and clock/shutdown checks.",
        "No alarm lateness SLA or invented sum-of-timeouts completion bound is claimed."
      ]
    },
    {
      "dot": "rose",
      "title": "C2 remains separate",
      "items": [
        "This child does not compensate state after other definite no-POST refusals.",
        "Actual rejected/unknown sends retain durable claims and existing six-hour one-shot behavior."
      ]
    },
    {
      "dot": "emerald",
      "title": "Checks still required",
      "items": [
        "Existing60-test delivery baseline passed; no new fix test has run yet.",
        "Required proof: more than six members cross a minute, selected edits/windows reject correctly, restart does not resend.",
        "Use owned peers only; no live providers, devices, merge or deployment authority."
      ]
    }
