  "cards": [
    {
      "dot": "cyan",
      "title": "Proposed contract",
      "items": [
        "S3 remains authoritative; no live execution claim",
        "Unchanged identity: zero raw GET, parse or fold",
        "Disk shares the existing private owner and allocated-byte cap"
      ]
    },
    {
      "dot": "rose",
      "title": "Invalidation and failure",
      "items": [
        "Known writes fence only the affected grid/family or mid key",
        "Active writer: request-local rebuild, no complete IDs or cache fill",
        "Expired or failed validation rebuilds; overlays remain request-local",
        "Other keys continue serving; no verification runtime flag"
      ]
    }
  ]
