    {
      "dot": "amber",
      "title": "Deadline and ownership",
      "items": [
        "Air, narrative and city inputs share a three-second budget; city answers queue for the CPU until eight seconds.",
        "Only prepared rows are returned; acquisition continues after deadline or disconnect."
      ]
    },
    {
      "dot": "cyan",
      "title": "Durability and boundaries",
