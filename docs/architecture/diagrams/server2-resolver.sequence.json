    {
      "id": "step-5",
      "from": "resolver",
      "to": "archive",
      "y": 320,
      "label": "Read complete published catalog first",
      "variant": "default",
      "note": "Whole pinned acquisitions, scoped pages or exact group. A subset is not full history."
    },
    {
      "id": "step-6",
      "from": "archive",
      "to": "resolver",
      "y": 360,
      "label": "Verified complete records or proved empty",
      "variant": "return",
      "note": "Absent/incomplete reads require finite recovery. Any possible recovery PUT marks mutation before send; cancellation preserves uncertainty. Capacity/Timeout are not misses."
    },
    {
      "id": "maintain-1",
      "from": "resolver",
      "to": "archive",
      "y": 400,
      "label": "Positive read: bounded background repair",
      "variant": "default",
      "note": "At most one repair overall; spare owner and 64 MiB lease, <=3s, no queue/provider. Skips retry only at a later positive cold read."
    },
    {
      "id": "maintain-2",
      "from": "archive",
      "to": "resolver",
      "y": 440,
      "label": "Index completion or bounded failure",
      "variant": "return",
      "note": "Foreground/background possible writes invalidate reuse even on ambiguity; read-only failure does not. Incomplete never proves synced or empty."
    },
    {
      "id": "step-7",
      "from": "resolver",
      "to": "acquire",
      "y": 480,
      "label": "Only proved empty: funded acquisition",
      "variant": "security",
      "note": "Only complete finite owned scope may acquire; S08 implementation is a separate seam."
    },
    {
      "id": "step-8",
      "from": "acquire",
      "to": "resolver",
      "y": 520,
      "label": "Ordered raw pages and declaration",
      "variant": "return"
    },
    {
      "id": "step-9",
      "from": "resolver",
      "to": "archive",
      "y": 560,
      "label": "Publish raw and every sibling catalog",
      "variant": "emphasis",
      "note": "The optional new-data branch must be durable before new success."
    },
    {
      "id": "step-10",
      "from": "archive",
      "to": "resolver",
      "y": 600,
      "label": "Complete group acknowledged",
      "variant": "return"
    },
    {
      "id": "step-12",
      "from": "resolver",
      "to": "memory",
      "y": 680,
      "label": "Admit immutable views and dependencies",
      "variant": "default",
      "note": "Optional raw/parsed retention cannot starve response admission. Excluded groups or epoch drift bypass response caching."
    },
    {
      "id": "step-13",
      "from": "memory",
      "to": "resolver",
      "y": 720,
      "label": "Byte leases retained or cache bypass",
      "variant": "return",
      "note": "External pins retain their charge. Epoch drift does not fail an already checked response."
    },
    {
      "id": "step-14",
      "from": "resolver",
      "to": "request",
      "y": 760,
      "label": "Return checked response bytes",
      "variant": "return"
    },
