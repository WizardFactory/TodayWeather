  "cards": [
    {
      "dot": "emerald",
      "title": "Serving correctness",
      "items": [
        "Memory, then bounded S3 lookup, then only a proved-empty funded provider branch.",
        "No new success before complete raw/group publication; active route parity remains a later gate."
      ]
    },
    {
      "dot": "amber",
      "title": "Memory and cancellation",
      "items": [
        "Optional raw/parsed maps yield to bounded response admission. External pins retain their byte charge.",
        "Owned waiter-independent tasks drain; reports count owners and view jobs, not every codec worker.",
        "Unchanged refresh reuses its payload/lease. TTL is rechecked after dependency I/O and is never extended."
      ]
    },
    {
      "dot": "rose",
      "title": "Privacy and scope",
      "items": [
        "Geocode key/privacy primitives only; value caching and exact-label proof remain S10 work.",
        "Warm foreground responses start no S3 work; maintenance is counted separately. Cold costs need S09 measurement."
      ]
    }
  ]
