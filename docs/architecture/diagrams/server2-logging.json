  "cards": [
    {
      "dot": "cyan",
      "title": "Design scope",
      "items": [
        "Specification for issue2802; not implementation or deployment evidence.",
        "HTTP wire behavior, attempts, deadlines and delivery ownership stay unchanged."
      ]
    },
    {
      "dot": "amber",
      "title": "Incident semantics",
      "items": [
        "Accepted, durable, failed, cancelled and unknown are distinct outcomes.",
        "No URL, body, credential, coordinate, registration ID or notification text enters the event API.",
        "The operator starts from terminal failures and follows parent / shared-owner IDs."
      ]
    },
    {
      "dot": "rose",
      "title": "Output failure",
      "items": [
        "A blocked stderr sink can lose diagnostics; independent counters expose the gap.",
        "A loss summary is best-effort when output becomes available; logs are not a durable business ledger."
      ]
    }
  ]
}
