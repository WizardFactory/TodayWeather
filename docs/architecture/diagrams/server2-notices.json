  "cards": [
    {
      "dot": "emerald",
      "title": "Durable operator state",
      "items": [
        "S3 is authoritative; local state is a verified read fallback only",
        "Conditional writes retain numeric IDs and operation identities"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure and translation",
      "items": [
        "No key or failed language does not block publishing valid original text",
        "Missing state is null; cold unreadable or corrupt state is 503"
      ]
    },
