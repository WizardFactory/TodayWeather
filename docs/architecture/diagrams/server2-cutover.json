{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "server2 S20 \u2014 proposed operational decision flow",
    "quality_profile": "showcase",
    "output": "docs/architecture/diagrams/server2-cutover.html"
  },
  "lanes": [
    {
      "id": "prep",
      "label": "Repository preparation \u2014 allowed now"
    },
    {
      "id": "decision",
      "label": "Evidence and authority \u2014 no automatic approval",
      "variant": "exception"
    },
    {
      "id": "ops",
      "label": "Future authorized switch \u2014 not executed"
    },
    {
      "id": "recovery",
      "label": "Future authorized recovery \u2014 not executed",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "inventory",
    "bundle",
    "rehearsal",
    "gate",
    "approve"
  ],
  "nodes": [
    {
      "id": "inventory",
      "lane": "prep",
      "col": 0,
      "type": "database",
      "label": "Inventory + local proof",
      "sublabel": "19 routes + widget / notice",
      "width": 165
    },
    {
      "id": "bundle",
      "lane": "prep",
      "col": 1,
      "type": "database",
      "label": "Candidate release pair",
      "sublabel": "code / config / state hashes",
      "width": 165
    },
    {
      "id": "rehearsal",
      "lane": "prep",
      "col": 2,
      "type": "backend",
      "label": "Owned local rehearsal",
      "sublabel": "fresh upstream per request",
      "width": 165
    },
    {
      "id": "gate",
      "lane": "decision",
      "col": 2,
      "type": "security",
      "label": "Operational evidence gate",
      "sublabel": "shadow / host / quota / state",
      "width": 165
    },
    {
      "id": "hold",
      "lane": "decision",
      "col": 3,
      "type": "security",
      "label": "Keep cutover blocked",
      "sublabel": "missing proof or prior bundle",
      "width": 165
    },
    {
      "id": "approve",
      "lane": "decision",
      "col": 4,
      "type": "external",
      "label": "Scoped AK authorization",
      "sublabel": "exact host / release / time",
      "width": 165
    },
    {
      "id": "drain",
      "lane": "ops",
      "col": 4,
      "type": "backend",
      "label": "Stop admission + workers",
      "sublabel": "drain jobs; preserve claims",
      "width": 165
    },
    {
      "id": "switch",
      "lane": "ops",
      "col": 3,
      "type": "backend",
      "label": "Activate selected release",
      "sublabel": "one worker owner; verify state",
      "width": 165
    },
    {
      "id": "observe",
      "lane": "ops",
      "col": 2,
      "type": "messagebus",
      "label": "Observe metrics",
      "sublabel": "errors / latency / durable state",
      "width": 165
    },
    {
      "id": "rollback",
      "lane": "recovery",
      "col": 2,
      "type": "security",
      "label": "Rollback decision",
      "sublabel": "unknown send never replayed",
      "width": 165
    },
    {
      "id": "prior",
      "lane": "recovery",
      "col": 1,
      "type": "backend",
      "label": "Eligible prior release",
      "sublabel": "no legacy; no journal rewind",
      "width": 165
    },
    {
      "id": "verify",
      "lane": "recovery",
      "col": 0,
      "type": "messagebus",
      "label": "Verify restored service",
      "sublabel": "same state; retained claims",
      "width": 165
    }
  ],
  "edges": [
    {
      "id": "inventory-bundle",
