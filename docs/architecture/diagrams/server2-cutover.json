    },
    {
      "id": "hold-approve",
      "from": "hold",
      "to": "approve",
      "label": "only after proof",
      "variant": "dashed"
    },
    {
      "id": "approve-drain",
      "from": "approve",
      "to": "drain",
      "label": "separate action",
      "variant": "dashed"
    },
    {
      "id": "drain-switch",
      "from": "drain",
      "to": "switch",
      "label": "",
      "variant": "default"
    },
    {
      "id": "switch-observe",
      "from": "switch",
