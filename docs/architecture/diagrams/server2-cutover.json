  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence scope",
      "items": [
        "Local S19 PASS is not seven-day shadow or whole-host rollback eligibility",
        "nginx rehearsal closes only the reused-connection deadline gap"
      ]
    },
    {
      "dot": "rose",
      "title": "Hard stop conditions",
      "items": [
        "No eligible previous bundle or incompatible durable state means no cutover",
        "No live shadow, host action, notification replay or quota measurement in this task"
      ]
    }
  ]
}
