  "cards": [
    {
      "dot": "cyan",
      "title": "Scheduling details",
      "items": [
        "Immediate startup pass; queued jobs use pop() and async.series.",
        "Current, shortest and air observations also dispatch outside the queue.",
        "Gather opt-in KMA_STN_MINUTE/HOURLY_ENABLED collectors; new stations geocoded via API_SERVER (#2573)."
      ]
    },
    {
      "dot": "amber",
      "title": "KMA compatibility (#2555)",
      "items": [
        "HTTP; reject partial pages and validate day-specific sea values.",
        "Hold hourly short activation until legacy consumers are repaired."
      ]
    },
    {
      "dot": "amber",
      "title": "RSS fallback \u2014 issue #2554 local change",
      "items": [
        "Collector stores wdEn; service maps ws to wsd and wd \u00d7 45 to vec.",
        "Newer RSS replaces valid source fields; equal fills gaps; older is skipped."
      ]
    },
    {
      "dot": "cyan",
      "title": "AirKorea recovery design (#2636)",
      "items": [
        "Migrate station/city observations to supported HTTPS services; validate full batches before writes.",
        "Await station and province aggregate storage; emit sanitized UTC outcomes.",
        "Nation: retain fresh province averages; absent data uses shared global air at representative points."
      ]
    },
    {
      "dot": "emerald",
      "title": "LifeIndex collection (#2650)",
      "items": [
        "UV V5 and seasonal oak/pine/weed pollen V3 run at /gather/lifeindex; pollen queries the current KST hour and all pages share that time; daily areaNo records.",
        "Retired food-poisoning and health-index collectors and the /gather/healthday schedule were removed. Food poisoning is tracked in #2600."
      ]
    },
    {
      "dot": "cyan",
      "title": "Unified keys \u2014 #2618 design",
      "items": [
        "DONGNAE_SECRET_KEYS supplies forecast/mid, warnings, UV/pollen, KASI and forecast-zone requests.",
        "Auth/quota rejection tries each list key once; exhaustion stops the logical request/cycle.",
        "AK verifies subscriptions and gather-host runs before deployment; AirKorea and opt-in ASOS keep separate settings."
      ]
    }
  ]
