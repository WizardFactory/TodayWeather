      "dot": "cyan",
      "title": "Local verification only",
      "items": [
        "Specification for S19c; no deployment or host rollback eligibility.",
        "Fixed family tests use their declared library/HTTP/recorded layers."
      ]
    },
    {
      "dot": "amber",
      "title": "Durable recovery",
      "items": [
        "Actual production lifecycle uses injected NativeFetch and fixed clock.",
        "A retained delivery claim forbids replay, including unknown results.",
        "Acknowledged state and claim bytes persist through release changes."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure stays visible",
      "items": [
        "Reject missing, equal or mismatched artifacts before any execution.",
        "Keep failed phases and logs; a no-op or absent report is never PASS.",
