# server2 settings (S10e, #2753). Copy the private legacy server/.env to server2/.env (mode 600;
# ignored by Git) and add the server2-only values below. server2 reads .env from its working
# directory (start it from server2/), with the legacy dotenv 10 rules: one KEY=value per line,
# matching quotes removed, the last duplicate wins, and process environment variables win over
# the file. server2 never reads server/.env. This file lists every variable server2 reads, with
# placeholders only; never commit real values.
#
# Built in, not settings: every provider and S3 endpoint, the metrics listener (loopback, the
# public port + 1), process limits, and provider quotas without a legacy setting (see
# docs/architecture/server2.md, "S10e legacy settings").

# --- Legacy server/.env names (same names and values as legacy config.js) ---
# Listener: OPENSHIFT_NODEJS_IP (default 127.0.0.1), OPENSHIFT_NODEJS_PORT, else PORT (default
# 3000). During coexistence give server2 a port other than the legacy origin's.
OPENSHIFT_NODEJS_IP=127.0.0.1
PORT=3002
# OPENSHIFT_NODEJS_PORT=

# S3 credentials and region (the bucket is server2-only, below).
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
TWA_S3_REGION=ap-northeast-2

# data.go.kr keys (JSON arrays; legacy dataGoKrKeys.parse rules). DONGNAE_SECRET_KEYS is
# required with the kma family.
DONGNAE_SECRET_KEYS='[]'
AIRKOREA_SECRET_KEYS='[]'

# AirKorea forecast image calibration (legacy config.js airkorea_korea_image; read with the kma
# family, parseFloat/parseInt as legacy). Unset or empty: the deployed values below, with the
# 820x820 size of the current images.
# AIRKOREA_KOREA_IMAGE_COORDI_TOP_LAT=39.3769
# AIRKOREA_KOREA_IMAGE_COORDI_BOTTOM_LAT=32.6942
# AIRKOREA_KOREA_IMAGE_COORDI_LEFT_LON=123.9523
# AIRKOREA_KOREA_IMAGE_COORDI_RIGHT_LON=130.6741
# AIRKOREA_KOREA_IMAGE_SIZE_WIDTH=820
# AIRKOREA_KOREA_IMAGE_SIZE_HEIGHT=820
# AIRKOREA_KOREA_IMAGE_MAP_LEFT=78
# AIRKOREA_KOREA_IMAGE_MAP_RIGHT=663
# AIRKOREA_KOREA_IMAGE_MAP_TOP=80
# AIRKOREA_KOREA_IMAGE_MAP_BOTTOM=798

# Geocoder keys.
GEOCODER_KAKAO_KEYS='[]'
GEOCODER_GOOGLE_KEY=

# Overseas weather (Visual Crossing): key and optional daily record budget (UTC day). 0 or
# unset: legacy has no budget; server2 then funds the documented free plan, 1000 records.
VC_SECRET_KEY=
VC_DAILY_RECORD_LIMIT=

# Air provider chain keys (legacy google_key, owm_keys, aqi_keys) and the legacy config/air.js
# free monthly caps (defaults 10000 and 1000000; a 5 % reserve stays unused).
GOOGLE_SECRET_KEY=
OWM_SECRET_KEY=
WAQI_SECRET_KEY=
# AIR_GOOGLE_MONTHLY_CAP=10000
# AIR_OWM_MONTHLY_CAP=1000000

# --- server2-only values (legacy has no equivalent) ---
# The server2 raw-record bucket; required when any family is native.
SERVER2_S3_BUCKET=

# Coexistence routing, removed with legacy retirement. SERVER2_GATEWAY_LEGACY_URL enables the
# gateway; SERVER2_NATIVE_FAMILIES lists the native families (geocode, dsf, kma; unset: all
# legacy); SERVER2_WORLD_VERSIONS selects the dsf versions (default v000901,v000902,v000903).
SERVER2_GATEWAY_LEGACY_URL=http://127.0.0.1:3000
# SERVER2_NATIVE_FAMILIES=
# SERVER2_WORLD_VERSIONS=v000901,v000902,v000903
