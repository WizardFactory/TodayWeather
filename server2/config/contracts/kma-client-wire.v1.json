  "checked_at": "2026-10-30",
  "evidence": [
    "docs/evidence/aws/api-traffic-2026-09-22.md",
    "server2/config/contracts/kma-history.v1.json"
  ],
  "legacy_corpora": [
    {
      "path": "server2/tests/golden/records.json",
      "kind": "golden"
    },
    {
      "path": "server2/tests/domestic/fixtures/oracle.json.gz",
      "kind": "oracle",
      "version": "v000903",
      "surface": "addr"
    },
    {
      "path": "server2/tests/legacy_versions/fixtures/kma-older.json.gz",
      "kind": "oracle",
      "surface": "addr"
    },
    {
      "path": "server2/tests/legacy_versions/fixtures/kma-town.json.gz",
      "kind": "oracle",
      "surface": "town"
    }
  ],
  "versions": {
