# server2 log collector: ships the `server2` journal namespace to the destinations
# selected by SERVER2_LOG_SINKS. render.py validates the settings first; with
# `local` only, the unit is skipped (the journal stays the only copy), and with
# invalid settings it fails without affecting server2.service.
[Unit]
Description=server2 log collector
# LogNamespace= orders a unit after its journal's sockets only; ordering after the
# namespace's journald service makes a shutdown stop this unit before its journal, so its
# final lines are kept (found by the LP-4 reboot check: they were lost otherwise).
After=network-online.target systemd-journald@server2.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
DynamicUser=yes
SupplementaryGroups=systemd-journal
StateDirectory=server2-logs
RuntimeDirectory=server2-logs
LogNamespace=server2
# "+": runs as root only to read the allowlisted names from server2's .env.
ExecCondition=+/usr/bin/python3 -I /opt/server2/logging/render.py --env-file /opt/server2/config/.env --state /var/lib/server2-logs --output /run/server2-logs/vector.json --version-file /opt/server2/logging/collector.json
# "+": root reads the checkpoints and the journal to report records rotated away
# before they were shipped (status.py, LP-2).
ExecStartPre=+/usr/bin/python3 -I /opt/server2/logging/status.py start --state /var/lib/server2-logs
ExecStart=/opt/server2/logging/vector --config /run/server2-logs/vector.json --graceful-shutdown-limit-secs 20
# Stop: wait (at most 75 s, about one S3 object window) until every destination has
# confirmed delivery up to the journal's end, then stop. This ships the server's final
# records and avoids resending records on the next start (LP-2, #2979).
# ${MAINPID} is empty when the collector already exited by itself: then nothing is waited for.
ExecStop=+/usr/bin/python3 -I /opt/server2/logging/status.py drain --state /var/lib/server2-logs --timeout 75 --main-pid=${MAINPID}
# Restart after a crash (signal, timeout), not after an exit code: invalid settings
# (255 from render.py, 78 from Vector) stay failed until the settings change.
Restart=on-abnormal
# Vector also exits with status 0 after an error it cannot handle (observed: an
# unreadable checkpoint); restart then too, so an unattended host does not stay without
# a collector. A requested stop is never restarted.
RestartForceExitStatus=0
RestartSec=5
# drain 75 s + collector shutdown 20 s + margin
TimeoutStopSec=100
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
