# S20c candidate only. Render into a private directory; never install this file directly.
# One server2 upstream connection per request preserves its 12s connection lifetime.
daemon off;
master_process off;
pid "{{PID}}";
error_log stderr notice;
events { worker_connections 128; }
http {
    access_log off;
    # Standard distro modules must not create their system-owned default paths.
    client_body_temp_path "{{WORKSPACE}}/client_body";
    proxy_temp_path "{{WORKSPACE}}/proxy";
    fastcgi_temp_path "{{WORKSPACE}}/fastcgi";
    uwsgi_temp_path "{{WORKSPACE}}/uwsgi";
    scgi_temp_path "{{WORKSPACE}}/scgi";
    client_max_body_size 0;
    keepalive_timeout 30s;
    upstream server2_candidate {
        server 127.0.0.1:{{UPSTREAM_PORT}};
    }
    server {
        listen 127.0.0.1:{{LISTEN_PORT}};
        location / {
            proxy_pass http://server2_candidate;
            proxy_http_version 1.0;
            proxy_set_header Connection close;
            proxy_set_header Host $http_host;
            proxy_connect_timeout 1s;
            proxy_read_timeout 15s;
            proxy_send_timeout 15s;
            proxy_next_upstream off;
            proxy_intercept_errors off;
            proxy_redirect off;
            proxy_cache off;
            proxy_buffering off;
        }
    }
}
