{
  "name": "todayweather-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/weather-core",
    "web",
    "packages/design-tokens"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/web-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build -w @todayweather/web",
    "test:e2e": "playwright test",
    "start": "node scripts/web-static-preview.mjs",
    "build:web": "npm run build -w @todayweather/web",
    "preview:static": "node scripts/web-static-preview.mjs",
    "deploy:static": "node scripts/deploy-web-static.mjs",
    "test:layout": "node scripts/web-layout-check.mjs",
    "generate:tokens": "node packages/design-tokens/generate.mjs",
    "test:design": "node --test packages/design-tokens/test/*.test.mjs scripts/verification/design-chart-model.test.mjs",
    "gallery": "node scripts/design-gallery.mjs",
    "predev": "node packages/design-tokens/generate.mjs",
    "pretypecheck": "node packages/design-tokens/generate.mjs",
    "pretest": "node packages/design-tokens/generate.mjs",
    "prebuild": "node packages/design-tokens/generate.mjs",
    "prebuild:web": "node packages/design-tokens/generate.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
