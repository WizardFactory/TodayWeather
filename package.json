{
  "name": "todayweather-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/weather-core",
    "web",
    "web-api"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/web-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run build -w @todayweather/web && npm run build -w @todayweather/api",
    "test:e2e": "playwright test",
    "start": "node web-api/dist/server.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
