<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The photo feed loads again when a network comes back (the Cordova online event). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".TodayWeatherApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TodayWeather">
        <!-- Analytics defaults of the Cordova build (cordova-plugin-firebasex-analytics variables). -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- Screen views are the app's own (Analytics.screen), as Ionic's routes were (config.xml). -->
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <!-- Crash reports are collected regardless of the analytics choice, as in the Cordova build. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="true" />

        <!-- AdMob (AN-15): Google's sample app ID in debug builds, TW_ADMOB_APP_ID_ANDROID in release builds, and the
             flags the Cordova build's AdMob plugin set. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />
        <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" />

        <!-- initOrder above FirebaseInitProvider's 100: revokes analytics before Firebase starts. -->
        <provider
            android:name=".EarlyStartProvider"
            android:authorities="${applicationId}.earlystart"
            android:exported="false"
            android:initOrder="1000" />

        <service
            android:name=".MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The Cordova launcher component name, so existing home-screen shortcuts open this activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TodayWeather.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
