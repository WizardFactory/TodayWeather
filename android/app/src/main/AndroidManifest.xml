<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The photo feed loads again when a network comes back (the Cordova online event). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The current position (AN-10): precise and approximate, asked together; no GPS hardware needed, as the Cordova
         build declared (GPS_REQUIRED false). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- S09 asks for it on Android 13+ (AN-14), as firebasex declared it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".TodayWeatherApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.TodayWeather">
        <!-- Analytics defaults of the Cordova build (cordova-plugin-firebasex-analytics variables). -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- No TCF intake: a UMP/TCF ad consent must not overwrite the app's denied ad storage, ad user data and ad
             personalization (play-services-measurement 24.0.0 reads IABTCF_* by default; CODEX-3178-22). -->
        <meta-data android:name="google_analytics_tcf_data_enabled" android:value="false" />
        <!-- Screen views are the app's own (Analytics.screen), as Ionic's routes were (config.xml). -->
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <!-- Crash reports are collected regardless of the analytics choice, as in the Cordova build. -->
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="true" />

        <!-- AdMob (AN-15): Google's sample app ID in debug builds, TW_ADMOB_APP_ID_ANDROID in release builds, and the
             flags the Cordova build's AdMob plugin set. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />
        <meta-data android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION" android:value="true" />
        <meta-data android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING" android:value="true" />
        <!-- The Cordova build's channel and color for the notifications FCM posts (firebasex 2.0.3, AN-14). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="fcm_default_channel" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_accent" />

        <!-- initOrder above FirebaseInitProvider's 100: revokes analytics before Firebase starts. -->
        <provider
            android:name=".EarlyStartProvider"
            android:authorities="${applicationId}.earlystart"
            android:exported="false"
            android:initOrder="1000" />

        <service
            android:name=".MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The tap targets of notifications the Cordova build posted itself; they open MainActivity (AN-14). -->
        <activity
            android:name="org.apache.cordova.firebasex.OnNotificationReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name="org.apache.cordova.firebasex.OnNotificationOpenReceiver"
            android:exported="false" />

        <activity android:name=".widget.WidgetConfigureActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.CurrentReceiver" android:exported="false"
            android:label="@string/widget_display_current">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_display_current" />
        </receiver>

        <receiver android:name=".widget.ForecastReceiver" android:exported="false"
            android:label="@string/widget_display_forecast">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_display_forecast" />
        </receiver>

        <receiver android:name=".widget.ClockReceiver" android:exported="false"
            android:label="@string/widget_display_clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_display_clock" />
        </receiver>

        <receiver android:name=".widget.AirReceiver" android:exported="false"
            android:label="@string/widget_display_air">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_display_air" />
        </receiver>

        <!-- The Cordova launcher component name, so existing home-screen shortcuts open this activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TodayWeather.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- todayweather://N, the place links of the TodayWeather widget (AN-16). 1.1.1 registered no scheme. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todayweather" />
            </intent-filter>
            <!--
              Verified App Links of link.todayweather.ai only (specs/deeplink.md §3.2); todayweather.ai and
              app.todayweather.ai stay in the browser. The paths are the canonical routes, with the tolerated trailing slash.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="link.todayweather.ai" />
                <data android:path="/" />
                <data android:path="/open" />
                <data android:path="/open/" />
                <data android:pathPrefix="/place/" />
                <data android:path="/loc" />
                <data android:path="/loc/" />
                <data android:pathPrefix="/air/" />
                <data android:path="/nation/weather" />
                <data android:path="/nation/weather/" />
                <data android:path="/nation/air" />
                <data android:path="/nation/air/" />
                <data android:path="/warnings" />
                <data android:path="/warnings/" />
            </intent-filter>
        </activity>
        <!--
          Unused Google Places Autocomplete / place-details widget activities (#3235): the app uses only
          PlacesClient and FindAutocompletePredictionsRequest (PlaceSearch.kt), so removing them lets R8
          and resource shrinking drop the unused widget UI. Re-check the merged release manifest after
          Places SDK upgrades and remove these entries if the widget UI is ever adopted.
        -->
        <activity
            android:name="com.google.android.libraries.places.widget.BasicPlaceAutocompleteActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.libraries.places.widget.PlaceAutocompleteActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.libraries.places.widget.internal.placedetails.photoviewer.PlacesLightboxActivity"
            tools:node="remove" />
    </application>
</manifest>
