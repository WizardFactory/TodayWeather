<resources>
    <style name="WidgetPreview">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textDirection">locale</item>
    </style>
    <style name="WidgetPreviewHeader" parent="WidgetPreview">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#9FE4E5</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetPreviewHero" parent="WidgetPreview">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetPreviewWeather" parent="WidgetPreview">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetPreviewClock" parent="WidgetPreview">
        <item name="android:textSize">42sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetPreviewDetail" parent="WidgetPreview">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#C0D9EB</item>
    </style>
    <style name="WidgetPreviewFooter" parent="WidgetPreview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#C0D9EB</item>
    </style>
    <style name="WidgetPreviewCellHeading" parent="WidgetPreview">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#C0D9EB</item>
    </style>
    <style name="WidgetPreviewCellValue" parent="WidgetPreview">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
