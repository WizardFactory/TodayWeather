<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TodayWeather" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!--
        Splash screen as the Cordova build's Theme.App.SplashScreen (its icon on white, 200 ms), kept until the
        data migration finishes.
    -->
    <style name="Theme.TodayWeather.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/Theme.TodayWeather</item>
    </style>
</resources>
