<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device transfer (API 31+; README "Backup and device transfer"). Only the user's data: the app state, and the
    Cordova storage the migration reads, so a backup or transfer taken from Cordova 1.1.1 restores and migrates. Not
    included, so not restored: the weather cache, the analytics choice (off again), Firebase's token and installation (a new
    FCM token), and the measurement, AdMob and UMP state (UMP asks again where consent is required).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_state.json" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="sharedpref" path="group.net.wizardfactory.todayweather.xml" />
        <include domain="sharedpref" path="net.wizardfactory.todayweather_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_state.json" />
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
        <include domain="sharedpref" path="group.net.wizardfactory.todayweather.xml" />
        <include domain="sharedpref" path="net.wizardfactory.todayweather_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
