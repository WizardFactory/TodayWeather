<?xml version="1.0" encoding="utf-8"?>
<!-- The launch splash masks its icon to a centred circle of 2/3 of the icon area (#3223): 240 dp or 288 dp on Android 12+
     depending on the icon background, 240 dp through core-splashscreen. A 25% inset per side draws the imported
     full-bleed splash_icon at half size, inside that circle at either size. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_icon"
    android:inset="25%" />
