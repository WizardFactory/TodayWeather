{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "web/src",
    "web-api/src",
    "packages/weather-core/src",
    "packages/weather-core/test",
    "web-api/test",
    "web/test",
    "web/vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
