<?xml version='1.0' encoding='utf-8'?>
<widget id="net.wizardfactory.todayweather" version="1.1.0" android-versionCode="100090" ios-CFBundleVersion="1" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>TodayWeather</name>
    <description>
        Inform how warm or cold it is today than yesterday.
    </description>
    <author email="todayweather@wizardfactory.net" href="https://github.com/WizardFactory">
        WizardFactory TodayWeather Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="BackupWebStorage" value="none" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="target-device" value="universal" />
    <preference name="AutoHideSplashScreen" value="false" />
    <preference name="SplashScreenDelay" value="1500" />
    <preference name="FadeSplashScreenDuration" value="0" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="KeyboardResize" value="false" />
    <preference name="cordova.plugins.diagnostic.modules" value="LOCATION" />
    <!-- Real AdMob app IDs come from client/.env at prepare time; package.json keeps Google's sample IDs. -->
    <hook type="after_prepare" src="scripts/admob-app-id.js" />
    <hook type="after_prepare" src="scripts/ios-no-tracking.js" />
    <platform name="android">
        <!-- Ionic routes own screen_view; suppress automatic Activity-level duplicates. -->
        <config-file target="AndroidManifest.xml" parent="application">
            <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        </config-file>
        <allow-intent href="market:*" />
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <!-- emi-indo-cordova-plugin-admob ships Kotlin sources; without this they are not compiled and startup crashes. -->
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <!-- play-services-ads 25.3 carries Kotlin 2.3 metadata; cordova-android 15 defaults to 2.1.21. -->
        <preference name="GradlePluginKotlinVersion" value="2.3.0" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="tw.resources/android-launcher-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#FFFFFF" />
        <!-- cordova-android 15 paints the status bar area itself; StatusBar.backgroundColorByHexString('#111') in app.js no longer shows. -->
        <preference name="StatusBarBackgroundColor" value="#111111" />
        <icon density="ldpi" src="tw.resources/android/icon/drawable-ldpi-icon.png" />
        <icon density="mdpi" src="tw.resources/android/icon/drawable-mdpi-icon.png" />
        <icon density="hdpi" src="tw.resources/android/icon/drawable-hdpi-icon.png" />
        <icon density="xhdpi" src="tw.resources/android/icon/drawable-xhdpi-icon.png" />
        <icon density="xxhdpi" src="tw.resources/android/icon/drawable-xxhdpi-icon.png" />
        <icon density="xxxhdpi" src="tw.resources/android/icon/drawable-xxxhdpi-icon.png" />
    </platform>
    <platform name="ios">
        <edit-config file="*-Info.plist" mode="merge" target="FirebaseAutomaticScreenReportingEnabled">
            <false />
        </edit-config>
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
        <preference name="scheme" value="app" />
        <preference name="hostname" value="localhost" />
        <preference name="deployment-target" value="15.0" />
        <!-- App Store icons must not have an alpha channel; icon-1024.png has one. -->
        <icon src="tw.resources/icon.png" width="1024" height="1024" />
        <splash src="tw.resources/ios/splash/Default@2x~universal~anyany.png" />
        <!-- The legacy app kept a native copy of TwStorage in this App Group (widget sharing); upgrades restore from it. -->
        <config-file target="*/Entitlements-Debug.plist" parent="com.apple.security.application-groups">
            <array>
                <string>group.net.wizardfactory.todayweather</string>
            </array>
        </config-file>
        <config-file target="*/Entitlements-Release.plist" parent="com.apple.security.application-groups">
            <array>
                <string>group.net.wizardfactory.todayweather</string>
            </array>
        </config-file>
        <!--
          App-level privacy manifest. Firebase and Google Mobile Ads ship their own manifests for what they collect.
          The app sends the device position (rounded to 3 decimals) for weather and a device/push identifier for
          push settings; neither is linked to an account or used for tracking. The plugins compiled into the app
          (firebasex, emi admob, app-preferences) use NSUserDefaults, including the App Group suite.
        -->
        <privacy-manifest>
            <key>NSPrivacyTracking</key>
            <false/>
            <key>NSPrivacyTrackingDomains</key>
            <array/>
            <key>NSPrivacyAccessedAPITypes</key>
            <array>
                <dict>
                    <key>NSPrivacyAccessedAPIType</key>
                    <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
                    <key>NSPrivacyAccessedAPITypeReasons</key>
                    <array>
                        <string>CA92.1</string>
                        <string>1C8F.1</string>
                    </array>
                </dict>
            </array>
            <key>NSPrivacyCollectedDataTypes</key>
            <array>
                <dict>
                    <key>NSPrivacyCollectedDataType</key>
                    <string>NSPrivacyCollectedDataTypePreciseLocation</string>
                    <key>NSPrivacyCollectedDataTypeLinked</key>
                    <false/>
                    <key>NSPrivacyCollectedDataTypeTracking</key>
                    <false/>
                    <key>NSPrivacyCollectedDataTypePurposes</key>
                    <array>
                        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                    </array>
                </dict>
                <dict>
                    <key>NSPrivacyCollectedDataType</key>
                    <string>NSPrivacyCollectedDataTypeDeviceID</string>
                    <key>NSPrivacyCollectedDataTypeLinked</key>
                    <false/>
                    <key>NSPrivacyCollectedDataTypeTracking</key>
                    <false/>
                    <key>NSPrivacyCollectedDataTypePurposes</key>
                    <array>
                        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                    </array>
                </dict>
            </array>
        </privacy-manifest>
        <edit-config file="*-Info.plist" mode="merge" target="NSLocationWhenInUseUsageDescription">
            <string>TodayWeather uses your location to show the weather where you are.</string>
        </edit-config>
    </platform>
</widget>
