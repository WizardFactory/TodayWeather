# TodayWeather mobile build inputs. Copy to client/.env (ignored by Git) and fill in.
# Never put passwords or key material here: store the locations of files that hold them.

# AdMob. These IDs ship inside the app binary.
TW_ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
TW_ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
TW_ADMOB_BANNER_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
TW_ADMOB_BANNER_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
TW_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
TW_ADMOB_INTERSTITIAL_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# API base URL. Overrides serverUrl from TW_ADS_CLIENT_CONFIG.
TW_SERVER_URL=https://<api-host>

# Where the release files are kept.
TW_RELEASE_AWS_PROFILE=<aws-profile>
TW_RELEASE_AWS_REGION=ap-northeast-2
TW_RELEASE_S3_PREFIX=s3://<bucket>/<prefix>/
# Local download directory for those files. Keep it outside the repository.
TW_RELEASE_LOCAL_DIR=$HOME/.config/todayweather/release

# File names under TW_RELEASE_S3_PREFIX and TW_RELEASE_LOCAL_DIR.
# Android release keystore.
TW_ANDROID_KEYSTORE=<name>.keystore
# Cordova build.json with the keystore alias and passwords.
TW_ANDROID_BUILD_JSON=<name>.build.json
TW_GOOGLE_SERVICES_JSON=<name>-google-services.json
TW_GOOGLE_SERVICE_INFO_PLIST=<name>-GoogleService-Info.plist
# Legacy client configuration (ad units, server URL). Reference only.
TW_ADS_CLIENT_CONFIG=<name>.ads.client.config.js
