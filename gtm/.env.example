# GTM tool inputs. Copy to a private gtm.env outside Git and fill in. See gtm/sources.md.
# Identifiers and file paths only; never paste key material here.

# Private record bucket and the collector's AWS profile.
TW_GTM_S3_URI=s3://<bucket>
TW_GTM_AWS_CREDENTIALS=$HOME/.config/todayweather/gtm/aws-credentials
TW_GTM_AWS_PROFILE=<profile>
# Local cache of records. Default: gtm/data/ (ignored).
TW_GTM_DATA_DIR=

# App Store Connect: team key with the "Sales and Reports" role.
TW_ASC_ISSUER_ID=<issuer-id>
TW_ASC_SALES_KEY_ID=<key-id>
TW_ASC_SALES_KEY_FILE=$HOME/.config/todayweather/gtm/AuthKey_<key-id>.p8
TW_ASC_VENDOR_NUMBER=<vendor-number>
# Provider token for App Store campaign links (pt=).
TW_ASC_PROVIDER_TOKEN=<provider-token>

# Google Play: release service account and the report bucket from Play Console.
TW_PLAY_JSON_KEY=/absolute/path/to/google-play-service-account.json
TW_PLAY_REPORT_BUCKET=gs://<report-bucket>

# AdMob: OAuth files and the publisher account.
TW_ADMOB_OAUTH_FILE=$HOME/.config/todayweather/gtm/admob-oauth.json
TW_ADMOB_PUBLISHER_ID=<publisher-id>
